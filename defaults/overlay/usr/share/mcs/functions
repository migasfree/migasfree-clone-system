#!/bin/bash
set -o pipefail

# SIZE EN MB

# Global partition definitions
# Must be loaded via load_partition_scheme from a project's partition.yml
_JSON_PARTITIONS=""

# Path to checksums file (loaded alongside partition.yml)
_CHECKSUMS_FILE=""
_VERIFY_CHECKSUMS=1

MCS_LOG_FILE="/var/log/mcs-clone.log"

mcs_log() {
    local _MSG="$1"
    # Ensure log directory exists
    mkdir -p "$(dirname "$MCS_LOG_FILE")"
    # Log with timestamp
    echo "$(date '+%Y-%m-%d %H:%M:%S') $_MSG" >> "$MCS_LOG_FILE"
    
    # Filter output to user: hide [DEBUG] and [INFO] to avoid cluttering the screen
    if [[ "$_MSG" == *"[DEBUG]"* ]] || [[ "$_MSG" == *"[INFO]"* ]]; then
        return
    fi
    echo "$_MSG" >&2
}

load_partition_scheme() {
    local _SOURCE="$1"
    local _FILE="partition.yml"
    local _TEMP="/tmp/partition.yml"
    local _CHECKSUMS_TEMP="/tmp/checksums.sha256"

    _JSON_PARTITIONS=""
    _CHECKSUMS_FILE=""

    if [[ "$_SOURCE" == http* ]]; then
        local _URL="$_SOURCE"
        [[ "$_URL" != */ ]] && _URL="${_URL%/*}/"
        mcs_log "  [DEBUG] Checking for mandatory partition.yml at ${_URL}${_FILE}"
        wget -q --timeout=15 -O "$_TEMP" "${_URL}${_FILE}" 2>/dev/null
    elif [ -d "$_SOURCE" ]; then
        mcs_log "  [DEBUG] Checking for mandatory partition.yml at $_SOURCE/$_FILE"
        cp "$_SOURCE/$_FILE" "$_TEMP" 2>/dev/null
    fi

    if [ -f "$_TEMP" ] && [ -s "$_TEMP" ]; then
        local _NEW_JSON=$(yq -o json '.partitions' "$_TEMP" 2>/dev/null)
        if [ -n "$_NEW_JSON" ] && [ "$_NEW_JSON" != "null" ]; then
            _JSON_PARTITIONS="$_NEW_JSON"
            mcs_log "  [DEBUG] Partition scheme loaded from $_FILE"
            # Load checksums (optional, warn if missing)
            if [[ "$_SOURCE" == http* ]]; then
                local _URL="$_SOURCE"
                [[ "$_URL" != */ ]] && _URL="${_URL%/*}/"
                wget -q --timeout=15 -O "$_CHECKSUMS_TEMP" "${_URL}checksums.sha256" 2>/dev/null
            elif [ -d "$_SOURCE" ]; then
                cp -- "$_SOURCE/checksums.sha256" "$_CHECKSUMS_TEMP" 2>/dev/null
            fi

            if [ -f "$_CHECKSUMS_TEMP" ] && [ -s "$_CHECKSUMS_TEMP" ]; then
                _CHECKSUMS_FILE="$_CHECKSUMS_TEMP"
                mcs_log "  [DEBUG] Checksums file loaded"
                # Verify partition.yml integrity before proceeding
                if ! verify_file_checksum "$_TEMP" "$_FILE"; then
                    rm -f -- "$_TEMP"
                    return 1
                fi
            else
                mcs_log "  [WARNING] No checksums.sha256 found, integrity verification disabled"
            fi

            rm -f -- "$_TEMP"
            return 0
        else
            mcs_log "  [ERROR] Failed to parse $_FILE (invalid YAML or missing 'partitions' key)"
        fi
    else
        mcs_log "  [ERROR] Mandatory partition.yml not found!"
    fi
    rm -f -- "$_TEMP"
    return 1
}


check_home_viability() {
    local _TARGET="$1"

    if [ -z "$_JSON_PARTITIONS" ] || [ "$_JSON_PARTITIONS" = "null" ]; then
        mcs_log "  [INFO] check_home_viability: No partition scheme loaded"
        return 1
    fi

    local _HOME_SCHEME=$(echo "$_JSON_PARTITIONS" | jq -r '.[] | select(.name == "HOME") | "\(.number)"' 2>/dev/null)
    local _SYSTEM_SCHEME=$(echo "$_JSON_PARTITIONS" | jq -r '.[] | select(.name == "SYSTEM") | "\(.number):\(.size)"' 2>/dev/null)

    if [ -z "$_HOME_SCHEME" ]; then
        mcs_log "  [INFO] check_home_viability: No HOME partition in scheme"
        return 1
    fi
    if [ -z "$_SYSTEM_SCHEME" ]; then
        mcs_log "  [INFO] check_home_viability: No SYSTEM partition in scheme"
        return 1
    fi

    local _HOME_NUM=$(echo "$_HOME_SCHEME" | cut -d: -f1)
    local _SYSTEM_NUM=$(echo "$_SYSTEM_SCHEME" | cut -d: -f1)
    local _SYSTEM_SIZE_MB=$(echo "$_SYSTEM_SCHEME" | cut -d: -f2)

    local _DISK_JSON=$(sfdisk -J "$_TARGET" 2>/dev/null)
    if [ -z "$_DISK_JSON" ]; then
        mcs_log "  [ERROR] check_home_viability: Cannot read partition table from $_TARGET"
        return 1
    fi

    local _HOME_NODE=$(echo "$_DISK_JSON" | jq -r --arg n "HOME" \
        '.partitiontable.partitions[] | select(.name == $n) | .node')
    if [ -z "$_HOME_NODE" ]; then
        mcs_log "  [INFO] check_home_viability: HOME partition not found on $_TARGET"
        return 1
    fi

    local _HOME_TARGET_NUM=$(echo "$_HOME_NODE" | sed 's/.*[^0-9]//')
    if [ "$_HOME_TARGET_NUM" != "$_HOME_NUM" ]; then
        mcs_log "  [INFO] check_home_viability: HOME partition number mismatch (scheme=$_HOME_NUM, target=$_HOME_TARGET_NUM)"
        return 1
    fi

    local _SYSTEM_NODE=$(echo "$_DISK_JSON" | jq -r --arg n "SYSTEM" \
        '.partitiontable.partitions[] | select(.name == $n) | .node')
    if [ -z "$_SYSTEM_NODE" ]; then
        mcs_log "  [INFO] check_home_viability: SYSTEM partition not found on $_TARGET"
        return 1
    fi

    local _SYSTEM_TARGET_NUM=$(echo "$_SYSTEM_NODE" | sed 's/.*[^0-9]//')
    if [ "$_SYSTEM_TARGET_NUM" != "$_SYSTEM_NUM" ]; then
        mcs_log "  [INFO] check_home_viability: SYSTEM partition number mismatch (scheme=$_SYSTEM_NUM, target=$_SYSTEM_TARGET_NUM)"
        return 1
    fi

    if [ -n "$_SYSTEM_SIZE_MB" ] && [ "$_SYSTEM_SIZE_MB" != "0" ] && [ "$_SYSTEM_SIZE_MB" != "null" ]; then
        local _SYSTEM_SIZE_SEC=$((_SYSTEM_SIZE_MB * 2048))
        local _SYSTEM_TARGET_SIZE=$(echo "$_DISK_JSON" | jq -r --arg n "SYSTEM" \
            '.partitiontable.partitions[] | select(.name == $n) | .size')
        if [ -n "$_SYSTEM_TARGET_SIZE" ] && [ "$_SYSTEM_TARGET_SIZE" != "null" ]; then
            if [ "$_SYSTEM_TARGET_SIZE" -lt "$_SYSTEM_SIZE_SEC" ]; then
                mcs_log "  [INFO] check_home_viability: SYSTEM partition too small (target=$_SYSTEM_TARGET_SIZE sectors, need=$_SYSTEM_SIZE_SEC)"
                return 1
            fi
        fi
    fi

    mcs_log "  [OK] HOME partition can be preserved on $_TARGET"
    return 0
}


# ============
# REQUIREMENTS
# ============

# MODULO NBD CARGADO
lsmod |grep "^nbd " >/dev/null
if [ $? -ne 0 ]
then
    modprobe nbd max_part=16 || :
fi


nbd-first-free() {
    local _DEVICE
    local _SYSFS="${MCS_SYSFS_PATH:-/sys/class/block}"
    for _DEVICE in $_SYSFS/nbd*
    do
       if [ "$(cat $_DEVICE/size)" = "0" ]
       then
           echo "/dev/$(basename $_DEVICE)"
           return 0
       fi
    done
    return 1
}

connect_HD() {
    local _TARGET="$1"
    local _DEVICE=""

    if [[ "$_TARGET" == http* ]]; then
        if [[ "$_TARGET" == */ ]]; then
            # Directory of raw images, no NBD needed
            echo "$_TARGET"
            return 0
        fi
        # Remote RAW image via HTTP via NBD
        mcs_log "[DEBUG] Connecting remote RAW image $_TARGET via NBD..."
        _DEVICE=$(nbd-first-free)
        mcs_log "[DEBUG] Using NBD device: $_DEVICE"

        local _IMG_OPTS="driver=raw,file.driver=http,file.url=$_TARGET,readahead=8388608"
        mcs_log "[DEBUG] Image opts: $_IMG_OPTS"

        qemu-nbd -r -c "$_DEVICE" --image-opts "$_IMG_OPTS" >/dev/null 2>&1
        
        # Wait for partitions to appear (up to 30 seconds)
        mcs_log "[DEBUG] Waiting for partitions on $_DEVICE..."
        local timeout=30
        while [ $timeout -gt 0 ]; do
            partprobe "$_DEVICE" >&2 2>/dev/null
            # Also try partx as fallback for NBD devices
            partx -a "$_DEVICE" 2>/dev/null || :
            if [ -e "${_DEVICE}p1" ] || [ -e "${_DEVICE}1" ]; then
                mcs_log "[DEBUG] Partitions detected after $((30 - timeout))s"
                echo "$_DEVICE"
                return 0
            fi
            sleep 1
            timeout=$((timeout - 1))
        done
        echo "  [ERROR] Partitions never appeared on $_DEVICE" >&2
        qemu-nbd -d "$_DEVICE" >/dev/null 2>&1
        return 1
    elif [ -d "$_TARGET" ]; then
        # Directory of raw images
        echo "$_TARGET"
        return 0
    elif [ -f "$_TARGET" ]; then
        # Local file
        mcs_log "[DEBUG] Connecting file $_TARGET via NBD..."
        _DEVICE=$(nbd-first-free)
        if [ -z "$_DEVICE" ]; then
            echo "  [ERROR] No free NBD device available" >&2
            return 1
        fi
        mcs_log "[DEBUG] Using NBD device: $_DEVICE"
        qemu-nbd -n -c "$_DEVICE" "$_TARGET" 2>&1 | tee -a $MCS_LOG_FILE

        # Wait for partitions to appear (up to 30 seconds)
        mcs_log "[DEBUG] Waiting for partitions on $_DEVICE..."
        local timeout=30
        while [ $timeout -gt 0 ]; do
            partprobe "$_DEVICE" >&2 2>/dev/null
            partx -a "$_DEVICE" 2>/dev/null || :
            if [ -e "${_DEVICE}p1" ] || [ -e "${_DEVICE}1" ]; then
                mcs_log "[DEBUG] Partitions detected after $((30 - timeout))s"
                echo "$_DEVICE"
                return 0
            fi
            sleep 1
            timeout=$((timeout - 1))
        done
        echo "  [ERROR] Partitions never appeared on $_DEVICE" >&2
        qemu-nbd -d "$_DEVICE" >/dev/null 2>&1
        return 1
    elif [ -b "$_TARGET" ]; then
        # Block device
        echo "$_TARGET"
        return 0
    fi

}


disconnect_HD() {
    local _DEVICE="$1"

    if [ ${_DEVICE:0:8} = "/dev/nbd" ]
    then
        sync
        sleep 2
        qemu-nbd -d "$_DEVICE" > /dev/null
    fi
}


disk_by_label() {
    # LABEL of FS
    local _LABEL="$1"
    local _KNAME=$(lsblk -J -o PKNAME,TYPE,LABEL 2>/dev/null | jq -r --arg l "$_LABEL" '.. | objects | select(.type == "part" and .label == $l) | .pkname' | head -n 1)
    if [ -z "$_KNAME" ] || [ "$_KNAME" = "null" ]; then
        return 1
    else
        echo "/dev/${_KNAME}"
    fi
}

part_by_label() {
    local _LABEL="$1"
    local _KNAME=$(lsblk -J -o KNAME,TYPE,LABEL 2>/dev/null | jq -r --arg l "$_LABEL" '.. | objects | select(.type == "part" and .label == $l) | .kname' 2>/dev/null | head -n 1)
    if [ -z "$_KNAME" ] || [ "$_KNAME" = "null" ]; then
        return 1
    else
        echo "/dev/${_KNAME}"
    fi
}


# part_uuid /dev/sda4  -> da32fdbc-0c84-4938-98b9-261cf0acbf9c
part_uuid() {
    # require util-linux package
    local _DEV_PARTITION="$1"
    echo $(blkid -s PARTUUID -o value "$_DEV_PARTITION")
}


# uuid_by_name /dev/sda SYSTEM  -> da32fdbc-0c84-4938-98b9-261cf0acbf9c
uuid_by_name() {
    local _DEVICE="$1"
    local _NAME="$2"
    part_uuid $(part_by_name ${_DEVICE} ${_NAME})
}

# uuid_by_id /dev/sda 4  -> da32fdbc-0c84-4938-98b9-261cf0acbf9c
uuid_by_id() {
    local _DEVICE="$1"
    local _NUMBER="$2"
    part_uuid $(part_by_id ${_DEVICE} ${_NUMBER})
}

prefix_part() {
    local _DEVICE="$1"
    local _BASE="${_DEVICE##*/}"
    # Devices ending with a digit use 'p' (nvme0n1, nbd0, mmcblk0, loop0)
    # Devices ending with a letter do not (sda, vda, xvda, hda)
    case "$_BASE" in
        *[0-9]) echo "p" ;;
        *)      echo ""  ;;
    esac
}


# part_by_id /dev/nvme0n1 5   -> /dev/nvme0n1p5
part_by_id() {
    local _DEVICE="$1"
    local _NUMBER="$2"
    local _PREFIX=$(prefix_part ${_DEVICE})
    echo "${_DEVICE}${_PREFIX}${_NUMBER}"
}

# id_by_part /dev/nvme0n1p5   -> 5
id_by_part() {
    local _DEV_PART="$1"
    local _DEVICE=$(dev_by_part ${_DEV_PART})
    local _PREFIX=$(prefix_part ${_DEVICE})
    local _LEN=$(( ${#_DEVICE} + ${#_PREFIX}))
    echo "${_DEV_PART:$_LEN}"
}


# dev_by_part /dev/nbd0p4   -> /dev/nbd0
dev_by_part() {
    local _DEV_PART="$1"
    local _DEVICE="/dev/$(lsblk -J -o KNAME,TYPE -s ${_DEV_PART} 2>/dev/null | jq -r '.. | objects | select(.type == "disk") | .kname' | head -n 1)"
    echo "${_DEVICE}"
}


# part_by_name /dev/sda SYSTEM   -> /dev/sda4
part_by_name() {
    local _DEVICE="$1"
    local _NAME="$2"
    local _DEV_PART=$(part_by_label_on_device "${_DEVICE}" "${_NAME}")
    if [ -z "${_DEV_PART}" ]; then
        local _NUMBER=$(echo "$_JSON_PARTITIONS" | jq -r --arg n "$_NAME" '.[] | select(.name == $n) | .number' 2>/dev/null)
        if [ -n "${_NUMBER}" ]; then
            _DEV_PART=$(part_by_id "${_DEVICE}" "${_NUMBER}")
        fi
    fi
    echo "${_DEV_PART}"
}

# Find partition by label ON A SPECIFIC DEVICE
part_by_label_on_device() {
    local _DEVICE="$1"
    local _LABEL="$2"
    # Use lsblk to find partitions belonging to _DEVICE with a specific LABEL
    # Redirect errors to stderr to avoid capturing them in variables
    lsblk -J -p -o NAME,LABEL,TYPE "${_DEVICE}" 2>/dev/null | jq -r --arg l "$_LABEL" '.. | objects | select(.type == "part" and .label == $l) | .name' | head -n 1
}

# part_label /dev/sda5  -> HOME
part_label() {
    local _DEV_PART="$1"
    lsblk -n -o LABEL $_DEV_PART
}


make_fstab() {
    local _DEVICE="$1"
    local _PARTITIONS=$(echo "$_JSON_PARTITIONS"|jq -r '.[] | "\(.number);\(.name);\(.mount);\(.filesystem);"')
    local _PARTITION
    local _NUMBER
    local _NAME
    local _MOUNT
    local _FILESYSTEM

    local _OLD_IFS="$IFS"
    IFS=$'\n'
    for _PARTITION in $_PARTITIONS
    do
        _NUMBER=$(echo "$_PARTITION" | awk -F ";" '{print $1}')
        _NAME=$(echo "$_PARTITION" | awk -F ";" '{print $2}')
        _MOUNT=$(echo "$_PARTITION" | awk -F ";" '{print $3}')
        _FILESYSTEM=$(echo "$_PARTITION" | awk -F ";" '{print $4}')
        case "$_NAME" in
            "SYSTEM")
                echo "PARTUUID=$(uuid_by_id ${_DEVICE} ${_NUMBER}) $_MOUNT $_FILESYSTEM errors=remount-ro 0 1"
                ;;
            "EFI")
                echo "PARTUUID=$(uuid_by_id ${_DEVICE} ${_NUMBER}) $_MOUNT $_FILESYSTEM umask=0077 0 1"
                ;;
            "SWAP")
                echo "PARTUUID=$(uuid_by_id ${_DEVICE} ${_NUMBER}) $_MOUNT $_FILESYSTEM sw 0 0"
                ;;
            "HOME")
                echo "PARTUUID=$(uuid_by_id ${_DEVICE} ${_NUMBER}) $_MOUNT $_FILESYSTEM defaults 0 2"
                ;;
            *)
                if [ -n "$_MOUNT" ]; then
                    mcs_log "  [WARNING] Unknown partition '$_NAME' with mount '$_MOUNT' — no fstab entry"
                fi
                ;;
        esac
    done
    IFS="$_OLD_IFS"
}


make_file_systems() {
    local _DEVICE="$1"
    local _PARTITIONS=$(echo "$_JSON_PARTITIONS"|jq -r '.[] | "\(.number);\(.name);\(.filesystem);"')
    local _PARTITION
    local _NUMBER
    local _NAME
    local _FILESYSTEM
    local _DEV_PART

    mcs_log "Creando sistemas de ficheros"
    mcs_log "============================"

    local _OLD_IFS="$IFS"
    IFS=$'\n'
    for _PARTITION in $_PARTITIONS
    do
        _NUMBER=$(echo "$_PARTITION" | awk -F ";" '{print $1}')
        _NAME=$(echo "$_PARTITION" | awk -F ";" '{print $2}')
        _FILESYSTEM=$(echo "$_PARTITION" | awk -F ";" '{print $3}')
        _DEV_PART=$(part_by_id ${_DEVICE} ${_NUMBER})

        case "$_FILESYSTEM" in
            "ext4")
                mcs_log "Partición $_NUMBER $_NAME -> ext4"
                umount ${_DEV_PART} 2>/dev/null || :
                LANG=C yes | mkfs.ext4 -E nodiscard ${_DEV_PART} >> "$MCS_LOG_FILE" 2>&1
                ;;
            "swap")
                mcs_log "Partición $_NUMBER $_NAME -> swap"
                umount ${_DEV_PART} 2>/dev/null || :
                LANG=C yes | mkswap ${_DEV_PART} >> "$MCS_LOG_FILE" 2>&1
                ;;
            "vfat")
                mcs_log "Partición $_NUMBER $_NAME -> fat"
                umount ${_DEV_PART} 2>/dev/null || :
                LANG=C yes | mkfs.fat ${_DEV_PART} >> "$MCS_LOG_FILE" 2>&1
                ;;
            *)
                ;;
        esac

        sleep 2
        sync

    done
    IFS="$_OLD_IFS"
}

get_megas_device()
{
    local _DEVICE="$1"

#    local _SIZE=$(fdisk -l $_DEVICE | grep " $_DEVICE: " | cut -d ' ' -f 5)
#    _SIZE=$((_SIZE/(1024*1024)))
#    echo $_SIZE
    echo $(blockdev --getsize64 ${_DEVICE} | awk '{ printf "%.0f\n", $1/1024/1024 }')

}


max_home_size() {
    local _DEVICE="$1"
    local _RESERVED=$(echo "$_JSON_PARTITIONS" | jq '[.[] | select(.name != "HOME") | .size | tonumber] | add')
    local _HOME_SIZE=$(echo "$_JSON_PARTITIONS" | jq '[.[] | select(.name == "HOME") | .size | tonumber] | add // 0')
    local _DISK_SIZE=$(get_megas_device "$_DEVICE")
    local _FREE_SIZE=$(( _DISK_SIZE - _RESERVED - 1 ))

    if [ "$_FREE_SIZE" -le "$_HOME_SIZE" ]; then
        echo "$_FREE_SIZE"
    else
        echo "$_HOME_SIZE"
    fi
}

# make_partitions "/dev/loop01"
make_partitions() {
    local _DEVICE="$1"
    local _SFDISK_SCRIPT="/tmp/sfdisk.script"

    echo
    mcs_log "Creating a new GPT partition table on $_DEVICE using sfdisk"
    
    # Header
    cat <<EOF > "$_SFDISK_SCRIPT"
label: gpt
unit: sectors
first-lba: 2048
EOF

    # Dynamic partitions from _JSON_PARTITIONS
    # Convert MB to sectors (MB * 2048)
    # Note: size=0 or empty means use the rest of the disk
    echo "$_JSON_PARTITIONS" | jq -r '.[] | 
        "\(.number) : " + 
        (if .number == "1" or .number == 1 then "start=2048, " else "" end) +
        (if .size != "0" and .size != 0 and .size != null then "size=\((.size|tonumber)*2048), " else "" end) + 
        "type=\(.type), name=\"\(.name)\""' >> "$_SFDISK_SCRIPT"

    sfdisk "$_DEVICE" < "$_SFDISK_SCRIPT" >> "$MCS_LOG_FILE" 2>&1
    check_result
    
    sync_parts "$_DEVICE"
    sfdisk -l "$_DEVICE"
}

check_result() {
    if [ $? = 0 ]
    then
      mcs_log "    [+] sfdisk done"
    else
      mcs_log "    [ERROR]"
      sleep 5
    fi
}


sync_parts() {
    local _DEVICE="$1"
    partprobe "$_DEVICE"
    sync
    udevadm settle 2>/dev/null || sleep 2
}


make_HD() {
    local _DEVICE="$1"
    local _SIZE="$2"

    if [ ! -b "$_DEVICE" ] && [ ! -f "$_DEVICE" ] && [ -z "$_SIZE" ]
    then
        _SIZE=$(( 250*1024 )) # en MB, solo para crear imágenes de prueba
    fi

    if [ -f "$_DEVICE" ]
    then
        echo "Error: file $_DEVICE exists." >&2
        return 1
    elif [ ! -b $_DEVICE ]
    then
        # lo creamos siempre en qcow2 porque falla mkfs.ext4 en vdi
        qemu-img create -f qcow2 "$_DEVICE" "${_SIZE}M"
    fi

    _DEV=$(connect_HD "$_DEVICE")
    make_partitions "$_DEV"
    sync_parts "$_DEV"
    make_file_systems "$_DEV"
    disconnect_HD "$_DEV"

}


# Verify integrity of a regular file using the loaded checksums file
verify_file_checksum() {
    local _FILE_PATH="$1"
    local _NAME="$2"

    if [ "$_VERIFY_CHECKSUMS" != "1" ] && [ "$_VERIFY_CHECKSUMS" != "true" ]; then
        return 0
    fi

    if [ -z "$_CHECKSUMS_FILE" ] || [ ! -f "$_CHECKSUMS_FILE" ]; then
        return 0
    fi

    # Check for exact name match in checksums file
    local _LINE=$(grep "[[:space:]]${_NAME}$" "$_CHECKSUMS_FILE" 2>/dev/null)
    if [ -z "$_LINE" ]; then
        return 0
    fi

    local _EXPECTED_SHA=$(echo "$_LINE" | awk '{print $1}')
    if [ -z "$_EXPECTED_SHA" ]; then
        return 0
    fi

    mcs_log "  [+] Verifying integrity of $_NAME..."
    local _ACTUAL_SHA=$(sha256sum "$_FILE_PATH" | awk '{print $1}')

    if [ "$_ACTUAL_SHA" = "$_EXPECTED_SHA" ]; then
        mcs_log "  [OK] Integrity verified for $_NAME"
        return 0
    else
        mcs_log "  [ERROR] Integrity check FAILED for $_NAME!"
        mcs_log "    Expected: $_EXPECTED_SHA"
        mcs_log "    Actual:   $_ACTUAL_SHA"
        return 1
    fi
}


verify_partition_checksum() {
    local _DEV_PART="$1"
    local _NAME="$2"

    if [ "$_VERIFY_CHECKSUMS" != "1" ] && [ "$_VERIFY_CHECKSUMS" != "true" ]; then
        mcs_log "  [INFO] Integrity verification disabled in settings, skipping $_NAME"
        return 0
    fi

    if [ -z "$_CHECKSUMS_FILE" ] || [ ! -f "$_CHECKSUMS_FILE" ]; then
        mcs_log "  [WARNING] No checksums file available, skipping integrity verification"
        return 0
    fi

    local _LINE=$(grep "[[:space:]]${_NAME}\.raw$" "$_CHECKSUMS_FILE" 2>/dev/null)
    if [ -z "$_LINE" ]; then
        mcs_log "  [WARNING] No checksum entry for $_NAME in checksums file"
        return 0
    fi

    local _EXPECTED_SHA=$(echo "$_LINE" | awk '{print $1}')
    local _EXPECTED_SIZE=$(echo "$_LINE" | awk '{print $2}')

    if [ -z "$_EXPECTED_SHA" ] || [ -z "$_EXPECTED_SIZE" ]; then
        mcs_log "  [ERROR] Invalid checksum entry for $_NAME: $_LINE"
        return 1
    fi

    mcs_log "  [+] Verifying integrity of $_NAME (${_EXPECTED_SIZE} bytes)..."
    local _ACTUAL_SHA=$(dd if="$_DEV_PART" bs=1M 2>/dev/null | head -c "$_EXPECTED_SIZE" | sha256sum | awk '{print $1}')

    if [ "$_ACTUAL_SHA" = "$_EXPECTED_SHA" ]; then
        mcs_log "  [OK] Checksum verified for $_NAME"
        return 0
    else
        mcs_log "  [ERROR] Checksum MISMATCH for $_NAME!"
        mcs_log "    Expected: $_EXPECTED_SHA"
        mcs_log "    Actual:   $_ACTUAL_SHA"
        return 1
    fi
}


# Resolve the target partition device for a given name and number
# Tries label match first, falls back to partition number
resolve_partition_target() {
    local _TARGET="$1"
    local _NAME="$2"
    local _NUMBER="$3"

    local _DEV_PART=$(part_by_label_on_device "$_TARGET" "$_NAME")
    if [ -n "$_DEV_PART" ]; then
        echo "$_DEV_PART"
    else
        part_by_id "$_TARGET" "$_NUMBER"
    fi
}

# Expand filesystem to fill partition
expand_filesystem() {
    local _DEV_PART="$1"
    local _NAME="$2"
    local _FS_TYPE=$(blkid -o value -s TYPE "$_DEV_PART" 2>/dev/null)
    
    case "$_FS_TYPE" in
        ext*)
            mcs_log "  [+] Expanding $_FS_TYPE filesystem on $_NAME ($_DEV_PART)..."
            e2fsck -f -p "$_DEV_PART" >> "$MCS_LOG_FILE" 2>&1 || :
            resize2fs "$_DEV_PART" >> "$MCS_LOG_FILE" 2>&1
            ;;
        *)
            mcs_log "  [DEBUG] Skipping resize for filesystem type: $_FS_TYPE"
            ;;
    esac
}

# Clone a single partition from an HTTP source (Turbo Clone: wget|dd)
clone_partition_http() {
    local _URL="$1"
    local _DEV_PART_TARGET="$2"
    local _NAME="$3"

    local _REMOTE_URL="${_URL}${_NAME}.raw"
    mcs_log "  [+] Copying partition $_NAME via wget from ${_REMOTE_URL}..."

    local _EXPECTED_SIZE=""
    if [ -f "$_CHECKSUMS_FILE" ]; then
        _EXPECTED_SIZE=$(awk -v name="${_NAME}.raw" '$3 == name {print $2}' "$_CHECKSUMS_FILE" 2>/dev/null)
    fi

    if [ -n "$_EXPECTED_SIZE" ]; then
        { wget -nv -O - "$_REMOTE_URL" 2>&1 1>&3 | tee /dev/stderr >> "$MCS_LOG_FILE"; } 3>&1 | pv -f -s "$_EXPECTED_SIZE" | dd of="${_DEV_PART_TARGET}" bs=1M conv=fsync 2>>"$MCS_LOG_FILE"
    else
        { wget -nv -O - "$_REMOTE_URL" 2>&1 1>&3 | tee /dev/stderr >> "$MCS_LOG_FILE"; } 3>&1 | pv -f | dd of="${_DEV_PART_TARGET}" bs=1M conv=fsync 2>>"$MCS_LOG_FILE"
    fi
    local _RET=$?
    sync
    if [ $_RET -ne 0 ]; then return 1; fi
    verify_partition_checksum "$_DEV_PART_TARGET" "$_NAME" || { mcs_log "  [WARNING] Integrity check failed for $_NAME"; return 1; }
    expand_filesystem "$_DEV_PART_TARGET" "$_NAME"
}

# Clone a single partition from a local directory source
clone_partition_local() {
    local _SOURCE_DIR="$1"
    local _DEV_PART_TARGET="$2"
    local _NAME="$3"

    local _RAW_FILE="${_SOURCE_DIR}/${_NAME}.raw"
    if [ ! -f "$_RAW_FILE" ]; then
        mcs_log "  [ERROR] Partition image not found: $_RAW_FILE"
        return 1
    fi

    mcs_log "  [+] Copying partition $_NAME from ${_RAW_FILE}..."
    
    local _EXPECTED_SIZE=""
    if [ -f "$_CHECKSUMS_FILE" ]; then
        _EXPECTED_SIZE=$(awk -v name="${_NAME}.raw" '$3 == name {print $2}' "$_CHECKSUMS_FILE" 2>/dev/null)
    fi

    if [ -n "$_EXPECTED_SIZE" ]; then
        pv -f -s "$_EXPECTED_SIZE" "$_RAW_FILE" | dd of="${_DEV_PART_TARGET}" bs=1M conv=fsync 2>>"$MCS_LOG_FILE"
    else
        pv -f "$_RAW_FILE" | dd of="${_DEV_PART_TARGET}" bs=1M conv=fsync 2>>"$MCS_LOG_FILE"
    fi
    local _RET=$?
    sync
    if [ $_RET -ne 0 ]; then return 1; fi
    verify_partition_checksum "$_DEV_PART_TARGET" "$_NAME" || { mcs_log "  [WARNING] Integrity check failed for $_NAME"; return 1; }
    expand_filesystem "$_DEV_PART_TARGET" "$_NAME"
}

# clone_HD clon.qcow2 /dev/sdx
clone_HD() {
    local _SOURCE="$1"
    local _TARGET="$2"
    local _PRESERVE_HOME="${3:-false}"
    local _ORIGIN_TARGET="${_TARGET}"
    local _RET=0

    load_partition_scheme "$_SOURCE" || return 1

    local _PARTITIONS=$(echo "$_JSON_PARTITIONS"|jq -r '.[] | select(.name == "HOME" or .name == "SYSTEM") | "\(.number);\(.name)"' 2>/dev/null)
    mcs_log "  [DEBUG] Total partitions in scheme: $(echo "$_JSON_PARTITIONS" | jq '. | length')"

    if [ "$_PRESERVE_HOME" = "true" ]; then
        mcs_log "  [INFO] PRESERVE_HOME enabled — skipping repartition and filesystem creation"
    else
        make_HD "$_TARGET" ""
    fi

    mcs_log "[DEBUG] Argument 1 (Image Path): $1"
    mcs_log "[DEBUG] Argument 2 (Target Disk): $2"

    _SOURCE=$(connect_HD "$1")
    [ -z "$_SOURCE" ] && { echo "  [ERROR] Failed to connect source: $1" >&2; return 1; }
    _TARGET=$(connect_HD "$2")
    [ -z "$_TARGET" ] && { echo "  [ERROR] Failed to connect target: $2" >&2; disconnect_HD "$_SOURCE"; return 1; }

    if [ "$_PRESERVE_HOME" = "true" ]; then
        backup_local_users "$_TARGET" || :
    fi

    mcs_log "[DEBUG] Connected Source: $_SOURCE"
    mcs_log "[DEBUG] Connected Target: $_TARGET"

    local _OLD_IFS="$IFS"
    IFS=$'\n'
    for _PARTITION in $_PARTITIONS
    do
        local _NUMBER=$(echo "$_PARTITION" | awk -F ";" '{print $1}')
        local _NAME=$(echo "$_PARTITION" | awk -F ";" '{print $2}')

        if [ "$_PRESERVE_HOME" = "true" ] && [ "$_NAME" = "HOME" ]; then
            mcs_log "  [SKIP] $_NAME partition preserved (existing user data kept)"
            continue
        fi

        mcs_log " "
        mcs_log "Clonando: $_NAME"
        mcs_log "================"

        local _DEV_PART_TARGET=$(resolve_partition_target "$_TARGET" "$_NAME" "$_NUMBER")
        if [ -z "$_DEV_PART_TARGET" ]; then
            mcs_log "  [ERROR] Cannot resolve target partition for $_NAME"
            _RET=1
            continue
        fi
        mcs_log "[DEBUG] Target device: $_DEV_PART_TARGET"

        if [[ "$_SOURCE" == http* ]]; then
            clone_partition_http "$_SOURCE" "$_DEV_PART_TARGET" "$_NAME" || _RET=1
        elif [ -d "$_SOURCE" ]; then
            clone_partition_local "$_SOURCE" "$_DEV_PART_TARGET" "$_NAME" || _RET=1
        else
            mcs_log "  [ERROR] Unknown source type for $_NAME cloning."
            _RET=1
        fi
    done
    IFS="$_OLD_IFS"

    disconnect_HD "$_TARGET"
    disconnect_HD "$_SOURCE"

    if [ $_RET -ne 0 ]; then
        mcs_log "  [ERROR] Cloning failed. Skipping bootloader configuration."
        return $_RET
    fi

    rescue "$_ORIGIN_TARGET"
    local _RES=$?
    if [ $_RES -eq 0 ]; then
        mcs_log "  [OK] Cloning and configuration finished successfully for $_ORIGIN_TARGET"
    fi
    return $_RES
}


# Ensure the freshly cloned target system can resolve the Migasfree server domain.
# If normal DNS resolution is unavailable (e.g., in a laboratory or offline network),
# this function injects a fallback entry mapping the server FQDN to its IP address
# into the target system's /etc/hosts file.
ensure_server_resolution() {
    local _MOUNT="$1"
    local _SERVER_URL="${SERVER_URL}"
    local _SERVER_IP="${SERVER_IP}"

    # If parameters are not in the environment, load them directly from config.yml
    if [ -z "$_SERVER_URL" ] && [ -f "/mcsdata/config.yml" ]; then
        _SERVER_URL=$(yq '.settings.server' < /mcsdata/config.yml 2>/dev/null)
        _SERVER_IP=$(yq '.settings.server_ip' < /mcsdata/config.yml 2>/dev/null)
    fi

    if [ -n "$_SERVER_URL" ]; then
        # Check if FQDN does NOT resolve (trying both host and nslookup as a fallback in BusyBox)
        if ! host "$_SERVER_URL" >/dev/null 2>&1 && ! nslookup "$_SERVER_URL" >/dev/null 2>&1; then
            mcs_log "  [WARNING] DNS does not resolve for $_SERVER_URL in the current network."
            if [ -f "${_MOUNT}/etc/hosts" ]; then
                mcs_log "  [+] Injecting fallback resolution in ${_MOUNT}/etc/hosts"
                
                # Remove any existing entries for the FQDN to prevent duplicates
                sed -i "/${_SERVER_URL}$/d" "${_MOUNT}/etc/hosts"
                
                local _IP_TO_WRITE="$_SERVER_IP"
                if [ -z "$_IP_TO_WRITE" ]; then
                    # Fallback: Extract the server IP mapping currently used by the installer itself
                    _IP_TO_WRITE=$(grep -E "${_SERVER_URL}$" /etc/hosts | awk '{print $1}' | head -n 1)
                fi
                
                if [ -n "$_IP_TO_WRITE" ]; then
                    echo "${_IP_TO_WRITE} ${_SERVER_URL}" >> "${_MOUNT}/etc/hosts"
                    mcs_log "  [OK] Injected resolution: ${_IP_TO_WRITE} ${_SERVER_URL} in target hosts file."
                else
                    mcs_log "  [ERROR] Failed to determine Migasfree server IP address."
                fi
            fi
        fi
    fi
}


rescue() {
    local _DEVICE="$1"
    local _MOUNT="${TEST_MOUNT:-/mnt/rescue}"

    mcs_log "Configuring Bootloader (Rescue)"
    mcs_log "=============================="

    _DEVICE=$(connect_HD "${_DEVICE}")
    local _DEV_SYSTEM=$(part_by_name "$_DEVICE" SYSTEM)
    local _DEV_EFI=$(part_by_name "$_DEVICE" EFI)

    mkdir -p "${_MOUNT}"
    mount -t auto "${_DEV_SYSTEM}" "${_MOUNT}" >> "$MCS_LOG_FILE" 2>&1

    # Ensure the target system can resolve the server FQDN
    ensure_server_resolution "${_MOUNT}"

    # Restore preserved user accounts and groups
    restore_local_users "${_MOUNT}" "$_DEVICE"

    if [ -n "$_DEV_EFI" ]; then
        mkdir -p "${_MOUNT}/boot/efi"
        mount -t auto "${_DEV_EFI}" "${_MOUNT}/boot/efi" >> "$MCS_LOG_FILE" 2>&1
    fi

    for dir in dev dev/pts proc sys run; do
        mkdir -p "${_MOUNT}/$dir"
        mount --bind "/$dir" "${_MOUNT}/$dir" >> "$MCS_LOG_FILE" 2>&1
    done

    mcs_log "Updating /etc/fstab..."
    make_fstab "$_DEVICE" > "${_MOUNT}/etc/fstab"

    mcs_log "Installing GRUB (BIOS)..."
    echo "(hd0) ${_DEVICE}" > "${_MOUNT}/boot/grub/device.map"

    # Ensure bios_grub flag is set on the BIOS partition (part 2)
    if which parted >/dev/null 2>&1; then
        parted -s "${_DEVICE}" set 2 bios_grub on >> "$MCS_LOG_FILE" 2>&1
    fi

    if chroot "${_MOUNT}" which grub-install >/dev/null 2>&1; then
        chroot "${_MOUNT}" grub-install --target=i386-pc --force --modules="part_gpt biosdisk ext2" "${_DEVICE}" 2>&1 | tee -a $MCS_LOG_FILE
    else
        mcs_log "  [WARNING] grub-install not found inside target, trying from host..."
        grub-install --target=i386-pc --boot-directory="${_MOUNT}/boot" --force --modules="part_gpt biosdisk ext2" "${_DEVICE}" 2>&1 | tee -a $MCS_LOG_FILE
    fi

    if [ -n "$_DEV_EFI" ]; then
        mcs_log "Installing GRUB (UEFI)..."
        # EFI mount for vars (only works if booted in UEFI mode)
        mount -t efivarfs efivarfs "${_MOUNT}/sys/firmware/efi/efivars" 2>/dev/null || :
        
        local _UEFI_SUCCESS=0
        if chroot "${_MOUNT}" which grub-install >/dev/null 2>&1; then
            # Using --removable ensures it works even if NVRAM cannot be updated (BIOS mode cloning)
            if chroot "${_MOUNT}" grub-install --target=x86_64-efi --efi-directory=/boot/efi --bootloader-id=grub --force --removable 2>&1 | tee -a $MCS_LOG_FILE; then
                _UEFI_SUCCESS=1
            fi
        fi

        if [ "$_UEFI_SUCCESS" -ne 1 ]; then
            mcs_log "  [WARNING] grub-install (UEFI) failed or not found inside target, trying from host..."
            if grub-install --target=x86_64-efi --boot-directory="${_MOUNT}/boot" --efi-directory="${_MOUNT}/boot/efi" --removable --force 2>&1 | tee -a $MCS_LOG_FILE; then
                _UEFI_SUCCESS=1
            fi
        fi

        # Ensure the fallback boot path exists and has the EFI binary
        if [ "$_UEFI_SUCCESS" -eq 1 ] && [ ! -f "${_MOUNT}/boot/efi/EFI/BOOT/BOOTX64.EFI" ]; then
            mkdir -p "${_MOUNT}/boot/efi/EFI/BOOT"
            # Try different possible source paths depending on the distro
            for _EFI_SRC in "grub/grubx64.efi" "debian/grubx64.efi" "ubuntu/grubx64.efi" "alpine/grubx64.efi"; do
                if [ -f "${_MOUNT}/boot/efi/EFI/${_EFI_SRC}" ]; then
                    cp "${_MOUNT}/boot/efi/EFI/${_EFI_SRC}" "${_MOUNT}/boot/efi/EFI/BOOT/BOOTX64.EFI"
                    break
                fi
            done
        fi
    fi

    mcs_log "Updating GRUB configuration..."
    if chroot "${_MOUNT}" which grub-mkconfig >/dev/null 2>&1; then
        # Disable os-prober temporarily to speed up and avoid confusion
        chroot "${_MOUNT}" test -e /etc/grub.d/30_os-prober && chroot "${_MOUNT}" mv /etc/grub.d/30_os-prober /tmp/ >> "$MCS_LOG_FILE" 2>&1 || :
        chroot "${_MOUNT}" touch /etc/grub.d/30_os-prober >> "$MCS_LOG_FILE" 2>&1 || :

        chroot "${_MOUNT}" grub-mkconfig -o /boot/grub/grub.cfg 2>&1 | tee -a $MCS_LOG_FILE

        # Restore os-prober
        chroot "${_MOUNT}" mv /tmp/30_os-prober /etc/grub.d/ >> "$MCS_LOG_FILE" 2>&1 || :
    else
        mcs_log "  [WARNING] grub-mkconfig not found inside target, skipping configuration update..."
    fi

    mcs_log "Updating initramfs..."
    if chroot "${_MOUNT}" which update-initramfs >/dev/null 2>&1; then
        chroot "${_MOUNT}" update-initramfs -u 2>&1 | tee -a $MCS_LOG_FILE
    else
        mcs_log "  [WARNING] update-initramfs not found inside target, skipping..."
    fi

    local _PARTUUID_SYSTEM=$(blkid -o value -s PARTUUID "${_DEV_SYSTEM}")
    if [ -n "$_PARTUUID_SYSTEM" ]; then
        mcs_log "Fixing root= in grub.cfg: ${_DEV_SYSTEM} -> PARTUUID=${_PARTUUID_SYSTEM}"
        sed -i.bak "s|root=${_DEV_SYSTEM}|root=PARTUUID=${_PARTUUID_SYSTEM}|g" "${_MOUNT}/boot/grub/grub.cfg" && rm -f "${_MOUNT}/boot/grub/grub.cfg.bak"
        sed -i.bak "s|root=UUID=[^ ]*|root=PARTUUID=${_PARTUUID_SYSTEM}|g" "${_MOUNT}/boot/grub/grub.cfg" && rm -f "${_MOUNT}/boot/grub/grub.cfg.bak"
    fi

    # Migasfree Sync (Optional)
    migasfree_sync_target "${_MOUNT}"

    # Execution of Provisioning Script
    if [ -f "/tmp/provision.sh.j2" ] && [ -f "/tmp/provision_answers.env" ]; then
        render_provision_script "/tmp/provision.sh.j2" "/tmp/provision_answers.env" "/tmp/provision_rendered.sh"
        run_provision_script "${_MOUNT}" "/tmp/provision_rendered.sh"
        rm -f /tmp/provision.sh.j2 /tmp/provision_answers.env /tmp/provision_rendered.sh
    fi


    mcs_log "Syncing and unmounting..."
    sync
    sleep 2
    umount -l "${_MOUNT}/dev/pts" 2>/dev/null
    for dir in run sys proc dev; do
        umount -l "${_MOUNT}/$dir" 2>/dev/null
    done
    umount "${_MOUNT}/sys/firmware/efi/efivars" 2>/dev/null
    umount "${_MOUNT}/boot/efi" 2>/dev/null
    # Clear the FAT dirty bit if it was cloned dirty or not closed cleanly
    if [ -n "$_DEV_EFI" ]; then
        dosfsck -a "$_DEV_EFI" >> "$MCS_LOG_FILE" 2>&1 || :
    fi
    umount "${_MOUNT}" 2>/dev/null
    sync
    rmdir "${_MOUNT}"

    disconnect_HD "${_DEVICE}"
}


resize_MCS_DATA() {
    local LABEL="MCS_DATA"
    local PART=$(part_by_label "$LABEL")
    local DISK=$(disk_by_label "$LABEL")

    # Silence kernel messages to avoid "unmounting" noise on screen
    local _OLD_DMESG=$(cat /proc/sys/kernel/printk)
    echo "1 4 1 7" > /proc/sys/kernel/printk

    umount $PART 2>/dev/null || :
    parted --script --fix $DISK resizepart 4 100% >> "$MCS_LOG_FILE" 2>&1
    partprobe $DISK
    sleep 2
    e2fsck -f -p $PART >> "$MCS_LOG_FILE" 2>&1
    resize2fs $PART >> "$MCS_LOG_FILE" 2>&1
    mount $PART /mcsdata

    # Restore dmesg level
    echo "$_OLD_DMESG" > /proc/sys/kernel/printk
}

# void free_nbd(void)
free_nbd() {
    for i in $(seq 0 15)
    do
        nbd-client -d "/dev/nbd$i"
    done
}

# migasfree_sync_target /mnt/rescue
migasfree_sync_target() {
    local _MOUNT="$1"
    
    if chroot "${_MOUNT}" which migasfree >/dev/null 2>&1; then
        mcs_log "  [+] Executing migasfree sync in target system..."
        # Copy resolv.conf to target to ensure network access in chroot
        cp /etc/resolv.conf "${_MOUNT}/etc/resolv.conf" 2>/dev/null || :
        
        # Process golden image identity file
        local _MGI_JSON="${_MOUNT}/etc/migasfree-golden-image.json"
        if [ -f "$_MGI_JSON" ] && which jq >/dev/null 2>&1; then
            # 1. Communicate tags for new machine
            local _TAGS=$(jq -r '.tags // empty' "$_MGI_JSON")
            if [ -n "$_TAGS" ]; then
                mcs_log "      Image Tags: ${_TAGS}"
                chroot "${_MOUNT}" migasfree tags --communicate ${_TAGS} >> "$MCS_LOG_FILE" 2>&1
            fi

            # 2. Inject clone_date
            mcs_log "  [+] Injecting clone_date into $_MGI_JSON"
            local _NOW=$(date -u +'%Y-%m-%dT%H:%M:%SZ')
            jq --arg date "$_NOW" '. + {clone_date: $date}' "$_MGI_JSON" > "${_MGI_JSON}.tmp" && mv "${_MGI_JSON}.tmp" "$_MGI_JSON"
        fi

        # Execute sync
        chroot "${_MOUNT}" migasfree sync >> "$MCS_LOG_FILE" 2>&1
        if [ $? -eq 0 ]; then
            mcs_log "  [OK] migasfree sync completed successfully"
        else
            mcs_log "  [WARNING] migasfree sync failed (see log for details)"
        fi

        local _HOST_NAME=$(chroot "${_MOUNT}" hostname)
        mcs_log "  [INFO] Target hostname: ${_HOST_NAME}"


    else
        mcs_log "  [DEBUG] migasfree sync not found in target system, skipping"
    fi
}


# backup_local_users "/dev/nbd0"
backup_local_users() {
    local _DEVICE="$1"
    local _DEV_SYSTEM=$(part_by_name "$_DEVICE" SYSTEM)
    
    if [ -z "$_DEV_SYSTEM" ] || [ ! -e "$_DEV_SYSTEM" ]; then
        mcs_log "  [WARNING] No SYSTEM partition found to backup user accounts"
        return 1
    fi
    local _TMP_MOUNT="/tmp/mnt_old_system"
    mkdir -p "$_TMP_MOUNT"
    
    if mount -o ro "$_DEV_SYSTEM" "$_TMP_MOUNT" 2>/dev/null; then
        mcs_log "  [+] Backup up pre-existing local user accounts..."
        mkdir -p /tmp/mcs_user_backup
        cp "$_TMP_MOUNT/etc/passwd" /tmp/mcs_user_backup/passwd 2>/dev/null
        cp "$_TMP_MOUNT/etc/shadow" /tmp/mcs_user_backup/shadow 2>/dev/null
        cp "$_TMP_MOUNT/etc/group" /tmp/mcs_user_backup/group 2>/dev/null
        cp "$_TMP_MOUNT/etc/gshadow" /tmp/mcs_user_backup/gshadow 2>/dev/null
        
        umount "$_TMP_MOUNT"
        rmdir "$_TMP_MOUNT"
        return 0
    else
        mcs_log "  [WARNING] Could not mount old SYSTEM partition, skipping user account backup"
        rmdir "$_TMP_MOUNT"
        return 1
    fi
}

# add_user_to_group "username" "groupname" "/mnt/rescue/etc/group"
add_user_to_group() {
    local _USER="$1"
    local _GROUP="$2"
    local _TARGET_FILE="$3"
    
    [ ! -f "$_TARGET_FILE" ] && return 0
    
    if grep -q "^${_GROUP}:" "$_TARGET_FILE"; then
        # Match user inside group members (last field)
        # To prevent matching a user name as substring (e.g. 'al' matching 'alberto'), we use \< and \>
        if ! grep -E -q "^${_GROUP}:[^:]*:[^:]*:(.*,)?${_USER}(,.*)?$" "$_TARGET_FILE"; then
            # Append user to group line (ends with ':') or comma-separated list
            sed -i -E "/^${_GROUP}:/ { /:$/! s/$/,$_USER/; /:$/ s/$/$_USER/ }" "$_TARGET_FILE"
        fi
    fi
}

# restore_local_users "/mnt/rescue"
restore_local_users() {
    local _MOUNT="$1"
    local _DEVICE="$2"
    local _BACKUP_DIR="/tmp/mcs_user_backup"
    
    if [ ! -f "$_BACKUP_DIR/passwd" ] || [ ! -f "$_BACKUP_DIR/shadow" ]; then
        return 1
    fi
    
    mcs_log "  [+] Merging preserved local user accounts (UID/GID >= 1000)..."
    
    # Ensure line endings in target database files are correct
    for file in passwd shadow group gshadow; do
        if [ -f "${_MOUNT}/etc/$file" ]; then
            [ -n "$(tail -c1 "${_MOUNT}/etc/$file" 2>/dev/null)" ] && echo "" >> "${_MOUNT}/etc/$file"
        fi
    done
    
    # 0. Snapshot UID 1000 admin from MGI image (authoritative — must always survive)
    local _MGI_ADMIN_PASSWD=$(awk -F: '$3 == 1000' "${_MOUNT}/etc/passwd" 2>/dev/null)
    local _MGI_ADMIN_SHADOW=""
    local _MGI_ADMIN_USER=""
    if [ -n "$_MGI_ADMIN_PASSWD" ]; then
        _MGI_ADMIN_USER=$(echo "$_MGI_ADMIN_PASSWD" | cut -d: -f1)
        _MGI_ADMIN_SHADOW=$(grep "^${_MGI_ADMIN_USER}:" "${_MOUNT}/etc/shadow" 2>/dev/null)
        mcs_log "      [PROTECT] MGI admin UID 1000: $_MGI_ADMIN_USER (will be enforced)"
    fi
    
    # 0b. Temporarily mount target HOME partition if _DEVICE is provided
    local _DEV_HOME=""
    local _MOUNTED_HOME="false"
    if [ -n "$_DEVICE" ] && [ -b "$_DEVICE" ]; then
        _DEV_HOME=$(part_by_name "$_DEVICE" HOME)
        if [ -n "$_DEV_HOME" ] && [ -e "$_DEV_HOME" ]; then
            mkdir -p "${_MOUNT}/home"
            # Unmount first if already mounted to avoid busy mounts
            umount "${_MOUNT}/home" >/dev/null 2>&1 || :
            if mount -t auto "${_DEV_HOME}" "${_MOUNT}/home" >> "$MCS_LOG_FILE" 2>&1; then
                _MOUNTED_HOME="true"
                mcs_log "      [INFO] Mounted target HOME partition at ${_MOUNT}/home"
            fi
        fi
    fi
    
    # 0c. Clean up old admin user (UID 1000) and its home directory if different from the new one
    local _BACKUP_ADMIN_ENTRY=$(awk -F: '$3 == 1000' "$_BACKUP_DIR/passwd" 2>/dev/null)
    if [ -n "$_BACKUP_ADMIN_ENTRY" ]; then
        local _BACKUP_ADMIN_USER=$(echo "$_BACKUP_ADMIN_ENTRY" | cut -d: -f1)
        local _BACKUP_ADMIN_HOME=$(echo "$_BACKUP_ADMIN_ENTRY" | cut -d: -f6)
        
        if [ -n "$_MGI_ADMIN_USER" ] && [ "$_BACKUP_ADMIN_USER" != "$_MGI_ADMIN_USER" ]; then
            mcs_log "      [CLEANUP] Deleting old admin user account and home directory: $_BACKUP_ADMIN_USER"
            
            # Delete its home directory from the mounted target HOME/SYSTEM partition
            if [ -n "$_BACKUP_ADMIN_HOME" ] && [ "$_BACKUP_ADMIN_HOME" != "/" ]; then
                local _REAL_BACKUP_HOME="${_MOUNT}${_BACKUP_ADMIN_HOME}"
                if [ -d "$_REAL_BACKUP_HOME" ]; then
                    rm -rf "$_REAL_BACKUP_HOME"
                    mcs_log "      [CLEANUP] Deleted old admin home: $_REAL_BACKUP_HOME"
                fi
            fi
            
            # Explicitly remove any remnants of the old admin user name from passwd and shadow
            sed -i "/^${_BACKUP_ADMIN_USER}:/d" "${_MOUNT}/etc/passwd"
            sed -i "/^${_BACKUP_ADMIN_USER}:/d" "${_MOUNT}/etc/shadow"
            
            # Explicitly remove any remnants of the old admin group name from group and gshadow
            sed -i "/^${_BACKUP_ADMIN_USER}:/d" "${_MOUNT}/etc/group"
            [ -f "${_MOUNT}/etc/gshadow" ] && sed -i "/^${_BACKUP_ADMIN_USER}:/d" "${_MOUNT}/etc/gshadow"
        fi
    fi
    
    # 0d. Ensure the admin's home directory exists and has correct ownership (1000:1000)
    if [ -n "$_MGI_ADMIN_USER" ] && [ -n "$_MGI_ADMIN_PASSWD" ]; then
        local _ADMIN_HOME_DIR=$(echo "$_MGI_ADMIN_PASSWD" | cut -d: -f6)
        if [ -n "$_ADMIN_HOME_DIR" ]; then
            local _REAL_ADMIN_HOME="${_MOUNT}${_ADMIN_HOME_DIR}"
            if [ ! -d "$_REAL_ADMIN_HOME" ]; then
                mcs_log "      [INFO] Creating missing home directory for admin: $_REAL_ADMIN_HOME"
                mkdir -p "$_REAL_ADMIN_HOME"
                if [ -d "${_MOUNT}/etc/skel" ]; then
                    cp -rT "${_MOUNT}/etc/skel" "$_REAL_ADMIN_HOME" 2>/dev/null || :
                fi
                chown -R 1000:1000 "$_REAL_ADMIN_HOME" 2>/dev/null || :
                chmod 750 "$_REAL_ADMIN_HOME" 2>/dev/null || :
            else
                # If home folder already exists, make sure the current admin owns it
                mcs_log "      [INFO] Fixing ownership for existing admin home directory: $_REAL_ADMIN_HOME"
                chown -R 1000:1000 "$_REAL_ADMIN_HOME" 2>/dev/null || :
            fi
        fi
    fi
    
    # 1. Merge passwd and shadow entries (UID >= 1000 and UID < 60000)
    local _USERS=$(awk -F: '$3 >= 1000 && $3 < 60000 {print $1}' "$_BACKUP_DIR/passwd" 2>/dev/null)
    for user in $_USERS; do
        [ "$user" = "nobody" ] && continue
        
        # Skip restoring centralized administrative users (they are managed in master MGI image)
        local _GECOS=$(grep "^${user}:" "$_BACKUP_DIR/passwd" | cut -d: -f5)
        if echo "$_GECOS" | grep -q -i "MIGASFREE-ADMIN"; then
            mcs_log "      Skipping centralized admin restoration: $user (using MGI credentials)"
            continue
        fi
        
        # Skip any backup user whose UID is 1000 if we are enforcing a target MGI admin
        if [ -n "$_MGI_ADMIN_USER" ]; then
            local _BACKUP_UID=$(grep "^${user}:" "$_BACKUP_DIR/passwd" | cut -d: -f3)
            if [ "$_BACKUP_UID" = "1000" ]; then
                mcs_log "      Skipping UID 1000 user: $user (reserved for MGI admin: $_MGI_ADMIN_USER)"
                continue
            fi
        fi
        
        local _PASSWD_ENTRY=$(grep "^${user}:" "$_BACKUP_DIR/passwd")
        local _SHADOW_ENTRY=$(grep "^${user}:" "$_BACKUP_DIR/shadow")
        if [ -n "$_PASSWD_ENTRY" ] && [ -n "$_SHADOW_ENTRY" ]; then
            # Deduplicate by username - remove existing target entries for the user
            sed -i "/^${user}:/d" "${_MOUNT}/etc/passwd"
            sed -i "/^${user}:/d" "${_MOUNT}/etc/shadow"
            
            echo "$_PASSWD_ENTRY" >> "${_MOUNT}/etc/passwd"
            echo "$_SHADOW_ENTRY" >> "${_MOUNT}/etc/shadow"
            mcs_log "      Restored user: $user"
        fi
    done
    
    # 1b. Enforce MGI admin UID 1000 if it exists — guarantee it is present and unmodified
    if [ -n "$_MGI_ADMIN_PASSWD" ] && [ -n "$_MGI_ADMIN_SHADOW" ]; then
        # Remove any entry that may have taken UID 1000 or the admin username
        sed -i "/^${_MGI_ADMIN_USER}:/d" "${_MOUNT}/etc/passwd"
        sed -i "/^${_MGI_ADMIN_USER}:/d" "${_MOUNT}/etc/shadow"
        # Also remove any other user that may have ended up with UID 1000
        awk -F: '$3 != 1000' "${_MOUNT}/etc/passwd" > "${_MOUNT}/etc/passwd.tmp" && \
            mv "${_MOUNT}/etc/passwd.tmp" "${_MOUNT}/etc/passwd"
        
        echo "$_MGI_ADMIN_PASSWD" >> "${_MOUNT}/etc/passwd"
        echo "$_MGI_ADMIN_SHADOW" >> "${_MOUNT}/etc/shadow"
        mcs_log "      [OK] MGI admin enforced: $_MGI_ADMIN_USER (UID 1000)"
    fi
    
    # 2. Merge group and gshadow entries (GID >= 1000 and GID < 60000)
    local _GROUPS=$(awk -F: '$3 >= 1000 && $3 < 60000 {print $1}' "$_BACKUP_DIR/group" 2>/dev/null)
    for group in $_GROUPS; do
        [ "$group" = "nogroup" ] && continue
        
        local _GROUP_ENTRY=$(grep "^${group}:" "$_BACKUP_DIR/group")
        local _GSHADOW_ENTRY=$(grep "^${group}:" "$_BACKUP_DIR/gshadow")
        if [ -n "$_GROUP_ENTRY" ]; then
            # Skip restoring groups whose GID is 1000 (belongs to MGI admin) if we are enforcing a target MGI admin
            if [ -n "$_MGI_ADMIN_USER" ]; then
                local _BACKUP_GID=$(echo "$_GROUP_ENTRY" | cut -d: -f3)
                if [ "$_BACKUP_GID" = "1000" ]; then
                    mcs_log "      Skipping GID 1000 group: $group (reserved for MGI admin group)"
                    continue
                fi
            fi
            
            sed -i "/^${group}:/d" "${_MOUNT}/etc/group"
            echo "$_GROUP_ENTRY" >> "${_MOUNT}/etc/group"
            
            if [ -n "$_GSHADOW_ENTRY" ] && [ -f "${_MOUNT}/etc/gshadow" ]; then
                sed -i "/^${group}:/d" "${_MOUNT}/etc/gshadow"
                echo "$_GSHADOW_ENTRY" >> "${_MOUNT}/etc/gshadow"
            fi
            mcs_log "      Restored group: $group"
        fi
    done
    
    # 3. Preserve supplemental memberships in system groups (GID < 1000)
    local _SYSTEM_GROUPS=$(awk -F: '$3 < 1000 {print $1}' "$_BACKUP_DIR/group" 2>/dev/null)
    local _USERS_LIST=" $(echo $_USERS | tr '\n' ' ') "
    for group in $_SYSTEM_GROUPS; do
        local _MEMBERS=$(grep "^${group}:" "$_BACKUP_DIR/group" | cut -d: -f4 | tr ',' ' ')
        for member in $_MEMBERS; do
            # Verify if member is one of our preserved standard users (UID >= 1000)
            case "$_USERS_LIST" in
                *" $member "*)
                    add_user_to_group "$member" "$group" "${_MOUNT}/etc/group"
                    add_user_to_group "$member" "$group" "${_MOUNT}/etc/gshadow"
                    ;;
            esac
        done
    done
    
    # 4. Enforce strict permissions
    chmod 644 "${_MOUNT}/etc/passwd" "${_MOUNT}/etc/group"
    chmod 600 "${_MOUNT}/etc/shadow"
    [ -f "${_MOUNT}/etc/gshadow" ] && chmod 600 "${_MOUNT}/etc/gshadow"
    
    # Clean up backup
    rm -rf "$_BACKUP_DIR"
    
    if [ "$_MOUNTED_HOME" = "true" ]; then
        umount "${_MOUNT}/home" >> "$MCS_LOG_FILE" 2>&1 || :
        mcs_log "      [INFO] Unmounted target HOME partition"
    fi
    return 0
}

# check_local_users_safety "/dev/sda"
check_local_users_safety() {
    local _DEV="$1"
    local _MOUNT_DIR="/tmp/mcs_safety_mount"
    
    # Find SYSTEM partition
    local _PART=$(part_by_label_on_device "$_DEV" "SYSTEM")
    if [ -z "$_PART" ]; then
        # If no SYSTEM partition exists, it is safe to proceed (e.g. fresh disk)
        return 0
    fi
    
    mkdir -p "$_MOUNT_DIR"
    if mount -o ro "$_PART" "$_MOUNT_DIR" 2>/dev/null; then
        local _RET=0
        if [ -f "$_MOUNT_DIR/etc/passwd" ]; then
            local _UID1000_LINE=$(awk -F: '$3 == 1000 {print $1 ":" $5}' "$_MOUNT_DIR/etc/passwd" 2>/dev/null)
            if [ -n "$_UID1000_LINE" ]; then
                local _B_USER=$(echo "$_UID1000_LINE" | cut -d: -f1)
                local _B_GECOS=$(echo "$_UID1000_LINE" | cut -d: -f2)
                if ! echo "$_B_GECOS" | grep -q -i "MIGASFREE-ADMIN"; then
                    mcs_log "  [ERROR] Local user '$_B_USER' has UID 1000 but is not MIGASFREE-ADMIN!"
                    dialog --title "ERROR: UID 1000 ocupado" \
                           --msgbox "El usuario local '$_B_USER' tiene el UID 1000 y no es el administrador central.\n\nPor seguridad, cambie el UID de '$_B_USER' manualmente antes de volver a clonar." 10 50
                    _RET=1
                fi
            fi
        fi
        umount "$_MOUNT_DIR"
        rm -rf "$_MOUNT_DIR"
        return $_RET
    else
        rm -rf "$_MOUNT_DIR"
        return 0
    fi
}

fetch_provision_script() {
    local _SOURCE="$1"
    local _FILE="provision.sh.j2"
    local _TEMP="/tmp/provision.sh.j2"
    
    rm -f "$_TEMP"
    if [[ "$_SOURCE" == http* ]]; then
        local _URL="$_SOURCE"
        [[ "$_URL" != */ ]] && _URL="${_URL%/*}/"
        wget -q --timeout=15 -O "$_TEMP" "${_URL}${_FILE}" 2>/dev/null
    elif [ -d "$_SOURCE" ]; then
        cp "$_SOURCE/$_FILE" "$_TEMP" 2>/dev/null
    fi

    if [ -f "$_TEMP" ] && [ -s "$_TEMP" ]; then
        echo "$_TEMP"
        return 0
    fi
    rm -f "$_TEMP"
    return 1
}

extract_provision_variables() {
    local _SCRIPT_PATH="$1"
    
    rm -f /tmp/mcs_vars.yml
    sed -n '/# --- MCS Variables ---/,/# ---/p' "$_SCRIPT_PATH" | sed -E 's/^#[[:space:]]?//' | grep -v '^---' > /tmp/mcs_vars.yml 2>/dev/null
    
    local _RAW_VARS
    _RAW_VARS=$(grep -o -E '\{\{[[:space:]]*[a-zA-Z0-9_]+[[:space:]]*\}\}' "$_SCRIPT_PATH" 2>/dev/null | tr -d '{ }' | sort -u)
    
    local _V
    for _V in $_RAW_VARS; do
        case "$_V" in
            server|project_name|project_slug|flavour|release|tags|base_os)
                # Omit automatic variables
                ;;
            *)
                echo "$_V"
                ;;
        esac
    done
}

get_auto_variables() {
    local _IMAGE_NAME="$1"
    echo "server=${SERVER_URL}"
    local _PROJ=$(echo "$_IMAGE_NAME" | cut -d'-' -f1)
    local _REL=$(echo "$_IMAGE_NAME" | cut -d'-' -f2)
    local _FLAV=$(echo "$_IMAGE_NAME" | cut -d'-' -f3)
    echo "project_name=${_PROJ}"
    echo "project_slug=${_PROJ}"
    echo "release=${_REL}"
    echo "flavour=${_FLAV}"
}

prompt_provision_variables() {
    local _SCRIPT_PATH="$1"
    local _IMAGE_NAME="$2"
    local _OUTPUT_FILE="/tmp/provision_answers.env"
    rm -f "$_OUTPUT_FILE"

    get_auto_variables "$_IMAGE_NAME" > "$_OUTPUT_FILE"

    local _VARS
    _VARS=$(extract_provision_variables "$_SCRIPT_PATH")
    if [ -z "$_VARS" ]; then
        return 0
    fi

    local _FORM_ARGS=()
    local _INDEX=1
    local _YAML_EXISTS=0
    if [ -f "/tmp/mcs_vars.yml" ] && [ -s "/tmp/mcs_vars.yml" ]; then
        _YAML_EXISTS=1
    fi

    local _VAR _LABEL _DEFAULT _REQ
    for _VAR in $_VARS; do
        _LABEL=""
        _DEFAULT=""
        _REQ="false"
        if [ $_YAML_EXISTS -eq 1 ]; then
            _LABEL=$(yq -e -r ".variables.${_VAR}.label" /tmp/mcs_vars.yml 2>/dev/null || echo "")
            _DEFAULT=$(yq -e -r ".variables.${_VAR}.default" /tmp/mcs_vars.yml 2>/dev/null || echo "")
            _REQ=$(yq -e -r ".variables.${_VAR}.required" /tmp/mcs_vars.yml 2>/dev/null || echo "false")
        fi

        if [ -z "$_LABEL" ] || [ "$_LABEL" = "null" ]; then
            _LABEL="$_VAR"
        fi
        if [ "$_DEFAULT" = "null" ]; then
            _DEFAULT=""
        fi

        _FORM_ARGS+=("${_LABEL}:" "$_INDEX" "1" "${_DEFAULT}" "$_INDEX" "25" "30" "0")
        _INDEX=$((_INDEX + 1))
    done

    if [ ${#_FORM_ARGS[@]} -eq 0 ]; then
        return 0
    fi

    local _FORM_HEIGHT=$(( _INDEX - 1 ))
    [ $_FORM_HEIGHT -lt 1 ] && _FORM_HEIGHT=1
    local _HEIGHT=$(( 7 + _FORM_HEIGHT ))
    local _RESPONSES
    _RESPONSES=$(dialog --stdout --backtitle "$TITLE" \
                        --title " Provisioning Variables " \
                        --form "" \
                        $_HEIGHT 65 $_FORM_HEIGHT \
                        "${_FORM_ARGS[@]}")
    
    local _RET=$?
    if [ $_RET -ne 0 ]; then
        return 1
    fi

    _INDEX=1
    for _VAR in $_VARS; do
        local _VAL
        _VAL=$(echo "$_RESPONSES" | sed -n "${_INDEX}p")
        echo "${_VAR}=${_VAL}" >> "$_OUTPUT_FILE"
        _INDEX=$((_INDEX + 1))
    done

    return 0
}

render_provision_script() {
    local _TEMPLATE_PATH="$1"
    local _VARIABLES_FILE="$2"
    local _OUTPUT_PATH="$3"

    while IFS='=' read -r key val; do
        if [ -n "$key" ]; then
            export "$key"="$val"
        fi
    done < "$_VARIABLES_FILE"

    sed 's/{{\s*\([a-zA-Z0-9_]\+\)\s*}}/${\1}/g' "$_TEMPLATE_PATH" > /tmp/provision_converted.sh

    local _ENV_VARS=""
    while IFS='=' read -r key val; do
        if [ -n "$key" ]; then
            _ENV_VARS="${_ENV_VARS} \$${key}"
        fi
    done < "$_VARIABLES_FILE"

    envsubst "$_ENV_VARS" < /tmp/provision_converted.sh > "$_OUTPUT_PATH"
    rm -f /tmp/provision_converted.sh
}

run_provision_script() {
    local _MOUNT="$1"
    local _SCRIPT_PATH="$2"
    
    if [ ! -f "$_SCRIPT_PATH" ]; then
        return 0
    fi
    
    mcs_log "  [+] Running Provisioning Script on target system..."
    
    local _DEST_SCRIPT="${_MOUNT}/tmp/provision.sh"
    cp "$_SCRIPT_PATH" "$_DEST_SCRIPT"
    chmod +x "$_DEST_SCRIPT"
    
    chroot "${_MOUNT}" /tmp/provision.sh >> "$MCS_LOG_FILE" 2>&1
    local _RET=$?
    
    rm -f "$_DEST_SCRIPT"
    
    if [ $_RET -eq 0 ]; then
        mcs_log "  [OK] Provisioning Script completed successfully."
        return 0
    else
        mcs_log "  [ERROR] Provisioning Script failed with exit code $_RET."
        return 1
    fi
}