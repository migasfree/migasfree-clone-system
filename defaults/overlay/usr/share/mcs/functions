#!/bin/bash
set -o pipefail

# SIZE EN MB

# Global partition definitions
# Must be loaded via load_partition_scheme from a project's partition.yml
_JSON_PARTITIONS=""

# Path to checksums file (loaded alongside partition.yml)
_CHECKSUMS_FILE=""
_VERIFY_CHECKSUMS=1

function mcs_log {
    local _MSG="$1"
    echo "$_MSG"
    echo "$(date '+%Y-%m-%d %H:%M:%S') $_MSG" >> /tmp/mcs-clone.log
}

function load_partition_scheme {
    local _SOURCE="$1"
    local _FILE="partition.yml"
    local _TEMP="/tmp/partition.yml"
    local _CHECKSUMS_TEMP="/tmp/checksums.sha256"

    _JSON_PARTITIONS=""
    _CHECKSUMS_FILE=""

    if [[ "$_SOURCE" == http* ]]; then
        local _URL="$_SOURCE"
        [[ "$_URL" != */ ]] && _URL="${_URL%/*}/"
        mcs_log "  [DEBUG] Checking for mandatory partition.yml at ${_URL}${_FILE}"
        wget -q --timeout=15 -O "$_TEMP" "${_URL}${_FILE}" 2>/dev/null
    elif [ -d "$_SOURCE" ]; then
        mcs_log "  [DEBUG] Checking for mandatory partition.yml at $_SOURCE/$_FILE"
        cp "$_SOURCE/$_FILE" "$_TEMP" 2>/dev/null
    fi

    if [ -f "$_TEMP" ] && [ -s "$_TEMP" ]; then
        local _NEW_JSON=$(yq -o json '.partitions' "$_TEMP" 2>/dev/null)
        if [ -n "$_NEW_JSON" ] && [ "$_NEW_JSON" != "null" ]; then
            _JSON_PARTITIONS="$_NEW_JSON"
            mcs_log "  [DEBUG] Partition scheme loaded from $_FILE"
            rm -f "$_TEMP"

            # Load checksums (optional, warn if missing)
            if [[ "$_SOURCE" == http* ]]; then
                local _URL="$_SOURCE"
                [[ "$_URL" != */ ]] && _URL="${_URL%/*}/"
                wget -q --timeout=15 -O "$_CHECKSUMS_TEMP" "${_URL}checksums.sha256" 2>/dev/null
            elif [ -d "$_SOURCE" ]; then
                cp "$_SOURCE/checksums.sha256" "$_CHECKSUMS_TEMP" 2>/dev/null
            fi
            if [ -f "$_CHECKSUMS_TEMP" ] && [ -s "$_CHECKSUMS_TEMP" ]; then
                _CHECKSUMS_FILE="$_CHECKSUMS_TEMP"
                mcs_log "  [DEBUG] Checksums file loaded"
            else
                mcs_log "  [WARNING] No checksums.sha256 found, integrity verification disabled"
            fi

            return 0
        else
            mcs_log "  [ERROR] Failed to parse $_FILE (invalid YAML or missing 'partitions' key)"
        fi
    else
        mcs_log "  [ERROR] Mandatory partition.yml not found!"
    fi
    rm -f "$_TEMP"
    return 1
}


# ============
# REQUIREMENTS
# ============

# MODULO NBD CARGADO
lsmod |grep "^nbd " >/dev/null
if ! [ $? = 0 ]
then
    modprobe nbd max_part=16 || :
fi


function nbd-first-free {
    local _DEVICE
    for _DEVICE in /sys/class/block/nbd*
    do
       if [ "$(cat $_DEVICE/size)" = "0" ]
       then
           echo "/dev/$(basename $_DEVICE)"
           break
       fi
    done
}

function connect_HD {
    local _TARGET="$1"
    local _DEVICE=""

    if [[ "$_TARGET" == http* ]]; then
        if [[ "$_TARGET" == */ ]]; then
            # Directory of raw images, no NBD needed
            echo "$_TARGET"
            return 0
        fi
        # Remote RAW image via HTTP via NBD
        echo "  [DEBUG] Connecting remote RAW image $_TARGET via NBD..." >&2
        _DEVICE=$(nbd-first-free)
        echo "  [DEBUG] Using NBD device: $_DEVICE" >&2

        local _IMG_OPTS="driver=raw,file.driver=http,file.url=$_TARGET,readahead=8388608"
        echo "  [DEBUG] Image opts: $_IMG_OPTS" >&2

        qemu-nbd -r -c "$_DEVICE" --image-opts "$_IMG_OPTS" >/dev/null 2>&1
        
        # Wait for partitions to appear (up to 30 seconds)
        echo "  [DEBUG] Waiting for partitions on $_DEVICE..." >&2
        local timeout=30
        while [ $timeout -gt 0 ]; do
            partprobe "$_DEVICE" >&2 2>/dev/null
            # Also try partx as fallback for NBD devices
            partx -a "$_DEVICE" 2>/dev/null || :
            if [ -e "${_DEVICE}p1" ] || [ -e "${_DEVICE}1" ]; then
                echo "  [DEBUG] Partitions detected after $((30 - timeout))s" >&2
                echo "$_DEVICE"
                return 0
            fi
            sleep 1
            timeout=$((timeout - 1))
        done
        echo "  [ERROR] Partitions never appeared on $_DEVICE" >&2
        qemu-nbd -d "$_DEVICE" >/dev/null 2>&1
        return 1
    elif [ -d "$_TARGET" ]; then
        # Directory of raw images
        echo "$_TARGET"
        return 0
    elif [ -f "$_TARGET" ]; then
        # Local file
        echo "  [DEBUG] Connecting file $_TARGET via NBD..." >&2
        _DEVICE=$(nbd-first-free)
        if [ -z "$_DEVICE" ]; then
            echo "  [ERROR] No free NBD device available" >&2
            return 1
        fi
        echo "  [DEBUG] Using NBD device: $_DEVICE" >&2
        qemu-nbd -n -c "$_DEVICE" "$_TARGET" 2>&1 | tee -a /tmp/mcs-clone.log

        # Wait for partitions to appear (up to 30 seconds)
        echo "  [DEBUG] Waiting for partitions on $_DEVICE..." >&2
        local timeout=30
        while [ $timeout -gt 0 ]; do
            partprobe "$_DEVICE" >&2 2>/dev/null
            partx -a "$_DEVICE" 2>/dev/null || :
            if [ -e "${_DEVICE}p1" ] || [ -e "${_DEVICE}1" ]; then
                echo "  [DEBUG] Partitions detected after $((30 - timeout))s" >&2
                echo "$_DEVICE"
                return 0
            fi
            sleep 1
            timeout=$((timeout - 1))
        done
        echo "  [ERROR] Partitions never appeared on $_DEVICE" >&2
        qemu-nbd -d "$_DEVICE" >/dev/null 2>&1
        return 1
    elif [ -b "$_TARGET" ]; then
        # Block device
        echo "$_TARGET"
    fi

}


function disconnect_HD {
    local _DEVICE="$1"

    if [ ${_DEVICE:0:8} = "/dev/nbd" ]
    then
        sync
        sleep 2
        qemu-nbd -d "$_DEVICE" > /dev/null
    fi
}


function ls_parts {
    local _DEVICE="$1"
    lsblk -o KNAME,TYPE ${_DEVICE} | grep part | awk '{print "/dev/"$1}'
}

function disk_by_label() {
    # LABEL of FS
    local _LABEL="$1"
    local _KNAME=$( \
        lsblk -o PKNAME,TYPE,LABEL | \
        awk '$2 == "part" {print $0}' | \
        grep "$_LABEL" | \
        awk '{print $1}'
        )
    if [ -z $_KNAME ]
    then
        return 1
    else
        echo "/dev/${_KNAME}"
    fi
}

function part_by_label() {
    local _LABEL="$1"
    local _KNAME=$( \
        lsblk -o KNAME,TYPE,LABEL | \
        awk '$2 == "part" {print $0}' | \
        grep "$_LABEL" | \
        awk '{print $1}'
        )
    if [ -z $_KNAME ]
    then
        return 1
    else
        echo "/dev/${_KNAME}"
    fi
}


function shrink_HD {
    _DEVICE="$1"
    _DEVICE=$(connect_HD ${_DEVICE})
    IFS=$'\n'
    for _DEV_PART in $(ls_parts ${_DEVICE})
    do
        umount ${_DEV_PART} 2>/dev/null || :
        shrink_part ${_DEVICE} $(id_by_part $_DEV_PART)
    done
    IFS=''
    disconnect_HD ${_DEVICE}
}


# shrink_part "/dev/loop0" "4"
function shrink_part {
    local _DEVICE="$1"
    local _NUMBER="$2"
    local _DEV_PART=$(part_by_id $_DEVICE $_NUMBER)
    local _TYPE=$(blkid -o value -s TYPE ${_DEV_PART})
    local _BLOCK=${_DEVICE:5} # eliminamos "/dev/"

    case $_TYPE in
        ext2|ext3|ext4)
            # Reducimos el FS
            e2fsck -f -y ${_DEV_PART}
            partprobe
            resize2fs -M ${_DEV_PART}   # shrink FS to minimal
            partprobe
            # Reducimos la particion
            # https://serverfault.com/questions/796758/shrink-partition-to-exactly-fit-the-underlying-filesystem-size
            local BLOCK_SIZE=$(tune2fs -l ${_DEV_PART} | grep "Block size:" |awk -F: '{print $2}')
            local BLOCK_COUNT=$(tune2fs -l ${_DEV_PART} | grep "Block count:" |awk -F: '{print $2}')
            local SECTOR_SIZE=$(cat /sys/block/${_BLOCK}/queue/hw_sector_size)
            local START_SECTOR=$(fdisk -l ${_DEVICE}|grep ${_DEV_PART} |awk '{print $2}')
            local FS_SIZE=$(($BLOCK_COUNT*$BLOCK_SIZE))
            local FS_SECTORS=$(($FS_SIZE/$SECTOR_SIZE))
            local PART_SECTORS=$(( (($FS_SECTORS-1)/2048+1)*2048 ))
            local END_SECTOR=$(( $START_SECTOR + $PART_SECTORS - 1 ))
            echo Yes | parted ---pretend-input-tty ${_DEVICE} resizepart $(echo ${_NUMBER}) ${END_SECTOR}s
            partprobe
        ;;
        *)
            echo "${_DEV_PART} TYPE: ${_TYPE} is not shrinkable"
        ;;
    esac
}


# part_uuid /dev/sda4  -> da32fdbc-0c84-4938-98b9-261cf0acbf9c
function part_uuid {
    # require util-linux package
    local _DEV_PARTITION="$1"
    echo $(blkid -s PARTUUID -o value "$_DEV_PARTITION")
}


# uuid_by_name /dev/sda SYSTEM  -> da32fdbc-0c84-4938-98b9-261cf0acbf9c
function uuid_by_name {
    local _DEVICE="$1"
    local _NAME="$2"
    part_uuid $(part_by_name ${_DEVICE} ${_NAME})
}

# uuid_by_id /dev/sda 4  -> da32fdbc-0c84-4938-98b9-261cf0acbf9c
function uuid_by_id {
    local _DEVICE="$1"
    local _NUMBER="$2"
    part_uuid $(part_by_id ${_DEVICE} ${_NUMBER})
}

function prefix_part {
    local _DEVICE="$1"
    local _PREFIX="p"
    if [ ${_DEVICE:0:7} = "/dev/sd" ]
    then
      _PREFIX=""
    fi
    echo "$_PREFIX"
}


# part_by_id /dev/nvme0n1 5   -> /dev/nvme0n1p5
function part_by_id {
    local _DEVICE="$1"
    local _NUMBER="$2"
    local _PREFIX=$(prefix_part ${_DEVICE})
    echo "${_DEVICE}${_PREFIX}${_NUMBER}"
}

# id_by_part /dev/nvme0n1p5   -> 5
function id_by_part {
    local _DEV_PART="$1"
    local _DEVICE=$(dev_by_part ${_DEV_PART})
    local _PREFIX=$(prefix_part ${_DEVICE})
    _LEN=$(( ${#_DEVICE} + ${#_PREFIX}))
    echo "${_DEV_PART:$_LEN}"
}


# dev_by_part /dev/nbd0p4   -> /dev/nbd0
function dev_by_part {
    local _DEV_PART="$1"
    local _DEVICE="/dev/$(lsblk -o KNAME,TYPE -s ${_DEV_PART}|grep disk|awk '{print $1}')"
    echo "${_DEVICE}"
}


# part_by_name /dev/sda SYSTEM   -> /dev/sda4
function part_by_name {
    local _DEVICE="$1"
    local _NAME="$2"
    local _DEV_PART=$(part_by_label_on_device "${_DEVICE}" "${_NAME}")
    if [ -z "${_DEV_PART}" ]; then
        local _NUMBER=$(echo "$_JSON_PARTITIONS" | jq ' .[] | select( .name == "'${_NAME}'") | .number | tonumber')
        _DEV_PART=$(part_by_id ${_DEVICE} ${_NUMBER})
    fi
    echo "${_DEV_PART}"
}

# Find partition by label ON A SPECIFIC DEVICE
function part_by_label_on_device {
    local _DEVICE="$1"
    local _LABEL="$2"
    # Use lsblk to find partitions belonging to _DEVICE with a specific LABEL
    # Redirect errors to stderr to avoid capturing them in variables
    lsblk -lnp -o NAME,LABEL "${_DEVICE}" 2>/dev/null | grep -w "${_LABEL}" | awk '{print $1}' | head -n 1
}

# part_label /dev/sda5  -> HOME
function part_label {
    local _DEV_PART="$1"
    lsblk -n -o LABEL $_DEV_PART
}


function make_fstab {
    local _DEVICE="$1"
    local _PARTITIONS=$(echo "$_JSON_PARTITIONS"|jq -r '.[] | "\(.number);\(.name);\(.mount);\(.filesystem);"')
    local _PARTITION
    local _NUMBER
    local _NAME
    local _MOUNT
    local _FILESYSTEM

    IFS=$'\n'
    for _PARTITION in $_PARTITIONS
    do
        _NUMBER=$(echo "$_PARTITION" | awk -F ";" '{print $1}')
        _NAME=$(echo "$_PARTITION" | awk -F ";" '{print $2}')
        _MOUNT=$(echo "$_PARTITION" | awk -F ";" '{print $3}')
        _FILESYSTEM=$(echo "$_PARTITION" | awk -F ";" '{print $4}')
        case "$_NAME" in
            "SYSTEM")
                echo "PARTUUID=$(uuid_by_id ${_DEVICE} ${_NUMBER}) $_MOUNT $_FILESYSTEM errors=remount-ro 0 1"
                ;;
            "EFI")
                echo "PARTUUID=$(uuid_by_id ${_DEVICE} ${_NUMBER}) $_MOUNT $_FILESYSTEM umask=0077 0 1"
                ;;
            "SWAP")
                echo "PARTUUID=$(uuid_by_id ${_DEVICE} ${_NUMBER}) $_MOUNT $_FILESYSTEM sw 0 0"
                ;;
            "HOME")
                echo "PARTUUID=$(uuid_by_id ${_DEVICE} ${_NUMBER}) $_MOUNT $_FILESYSTEM defaults 0 2"
                ;;
            *)
                ;;
        esac
    done
    IFS=''
}


function make_file_systems {
    local _DEVICE="$1"
    local _PARTITIONS=$(echo "$_JSON_PARTITIONS"|jq -r '.[] | "\(.number);\(.name);\(.filesystem);"')
    local _PARTITION
    local _NUMBER
    local _NAME
    local _FILESYSTEM
    local _DEV_PART

    echo
    echo "Creando sistemas de ficheros"
    echo "============================"

    IFS=$'\n'
    for _PARTITION in $_PARTITIONS
    do
        _NUMBER=$(echo "$_PARTITION" | awk -F ";" '{print $1}')
        _NAME=$(echo "$_PARTITION" | awk -F ";" '{print $2}')
        _FILESYSTEM=$(echo "$_PARTITION" | awk -F ";" '{print $3}')
        _DEV_PART=$(part_by_id ${_DEVICE} ${_NUMBER})

        case "$_FILESYSTEM" in
            "ext4")
                echo "Partición $_NUMBER $_NAME -> ext4"
                umount ${_DEV_PART} 2&> /dev/null || :
                LANG=C yes |  mkfs.ext4 -E nodiscard ${_DEV_PART}
                ;;
            "swap")
                echo "Partición $_NUMBER $_NAME -> swap"
                umount ${_DEV_PART} 2&> /dev/null || :
                LANG=C yes | mkswap ${_DEV_PART} > /dev/null
                ;;
            "vfat")
                echo "Partición $_NUMBER $_NAME -> fat"
                umount ${_DEV_PART} 2&> /dev/null || :
                LANG=C yes | mkfs.fat ${_DEV_PART}> /dev/null
                ;;
            *)
                ;;
        esac

        sleep 2
        sync

    done
    IFS=''
}


function set_journal {
    local _DEVICE="$1"
    local _PARTITIONS=$(echo "$_JSON_PARTITIONS"|jq -r '.[] | "\(.number);\(.name);\(.filesystem);"')
    local _PARTITION
    local _NUMBER
    local _NAME
    local _FILESYSTEM
    local _DEV_PART

    echo
    echo "Estableciendo journal"
    echo "====================="

    IFS=$'\n'
    for _PARTITION in $_PARTITIONS
    do
        _NUMBER=$(echo "$_PARTITION" | awk -F ";" '{print $1}')
        _NAME=$(echo "$_PARTITION" | awk -F ";" '{print $2}')
        _FILESYSTEM=$(echo "$_PARTITION" | awk -F ";" '{print $3}')
        _DEV_PART=$(part_by_id ${_DEVICE} ${_NUMBER})

        case "$_FILESYSTEM" in
            "ext4")
                umount ${_DEV_PART} 2&> /dev/null || :
                tune2fs -O has_journal ${_DEV_PART}
                ;;
            *)
                ;;
        esac
    done
    IFS=''
}



function get_megas_device
{
    local _DEVICE="$1"

#    local _SIZE=$(fdisk -l $_DEVICE | grep " $_DEVICE: " | cut -d ' ' -f 5)
#    _SIZE=$((_SIZE/(1024*1024)))
#    echo $_SIZE
    echo $(blockdev --getsize64 ${_DEVICE} | awk '{ printf "%.0f\n", $1/1024/1024 }')

}


function max_home_size {
    _DEVICE="$1"

    _RESERVED=$(echo "$_JSON_PARTITIONS" | jq ' .[] | select( .name != "HOME") | .size | tonumber')
    _RESERVED=$(echo 1+$_RESERVED | tr " " "+")
    _RESERVED=$(( $_RESERVED ))
    _FREE_SIZE=$(( $(get_megas_device $_DEVICE ) - $_RESERVED - 1 ))
    _HOME_SIZE=$(echo "$_JSON_PARTITIONS" | jq ' .[] | select( .name == "HOME") | .size | tonumber')

    # Limitar tamaño de la particion de datos
    if [ $_FREE_SIZE -le $_HOME_SIZE ]
    then
        echo $_FREE_SIZE
    else
        echo $_HOME_SIZE
    fi
}

# make_partitions "/dev/loop01"
function make_partitions {
    local _DEVICE="$1"
    local _SFDISK_SCRIPT="/tmp/sfdisk.script"

    echo
    echo "Creating a new GPT partition table on $_DEVICE using sfdisk"
    
    # Header
    cat <<EOF > "$_SFDISK_SCRIPT"
label: gpt
unit: sectors
first-lba: 2048
EOF

    # Dynamic partitions from _JSON_PARTITIONS
    # Convert MB to sectors (MB * 2048)
    # Note: size=0 or empty means use the rest of the disk
    echo "$_JSON_PARTITIONS" | jq -r '.[] | 
        "\(.number) : " + 
        (if .number == "1" or .number == 1 then "start=2048, " else "" end) +
        (if .size != "0" and .size != 0 and .size != null then "size=\((.size|tonumber)*2048), " else "" end) + 
        "type=\(.type), name=\"\(.name)\""' >> "$_SFDISK_SCRIPT"

    sfdisk "$_DEVICE" < "$_SFDISK_SCRIPT" &>/dev/null
    check_result
    
    partprobe "$_DEVICE"
    sync
    sleep 2
    sfdisk -l "$_DEVICE"
}

function check_result {
    if [ $? = 0 ]
    then
      echo "    [OK]"
    else
      echo "    \e[31m[ERROR]\e[0m"
      sleep 5
    fi
}


function make_HD {
    local _DEVICE="$1"
    local _SIZE="$2"

    if [ -z $_SIZE ]
    then
        _SIZE=$(( 250*1024 )) # en MB
    fi

    if [ -f $_DEVICE ]
    then
        echo "Error: file $_DEVICE exists." >&2
        exit 1
    elif ! [ -b $_DEVICE ]
    then
        # lo creamos siempre en qcow2 porque falla mkfs.ext4 en vdi
        qemu-img create -f qcow2 "$_DEVICE" "${_SIZE}M"
    fi

    _DEV=$(connect_HD "$_DEVICE")
    make_partitions "$_DEV"
    partprobe "$_DEV"
    sync
    sleep 2
    make_file_systems "$_DEV"
    disconnect_HD "$_DEV"

}


function verify_partition_checksum {
    local _DEV_PART="$1"
    local _NAME="$2"

    if [ "$_VERIFY_CHECKSUMS" != "1" ] && [ "$_VERIFY_CHECKSUMS" != "true" ]; then
        mcs_log "  [INFO] Integrity verification disabled in settings, skipping $_NAME"
        return 0
    fi

    if [ -z "$_CHECKSUMS_FILE" ] || [ ! -f "$_CHECKSUMS_FILE" ]; then
        mcs_log "  [WARNING] No checksums file available, skipping integrity verification"
        return 0
    fi

    local _LINE=$(grep "[[:space:]]${_NAME}\.raw$" "$_CHECKSUMS_FILE" 2>/dev/null)
    if [ -z "$_LINE" ]; then
        mcs_log "  [WARNING] No checksum entry for $_NAME in checksums file"
        return 0
    fi

    local _EXPECTED_SHA=$(echo "$_LINE" | awk '{print $1}')
    local _EXPECTED_SIZE=$(echo "$_LINE" | awk '{print $2}')

    if [ -z "$_EXPECTED_SHA" ] || [ -z "$_EXPECTED_SIZE" ]; then
        mcs_log "  [ERROR] Invalid checksum entry for $_NAME: $_LINE"
        return 1
    fi

    mcs_log "  [+] Verifying integrity of $_NAME (${_EXPECTED_SIZE} bytes)..."
    local _ACTUAL_SHA=$(dd if="$_DEV_PART" bs=1M 2>/dev/null | head -c "$_EXPECTED_SIZE" | sha256sum | awk '{print $1}')

    if [ "$_ACTUAL_SHA" = "$_EXPECTED_SHA" ]; then
        mcs_log "  [OK] Checksum verified for $_NAME"
        return 0
    else
        mcs_log "  [ERROR] Checksum MISMATCH for $_NAME!"
        mcs_log "    Expected: $_EXPECTED_SHA"
        mcs_log "    Actual:   $_ACTUAL_SHA"
        return 1
    fi
}


# clone_HD clon.qcow2 /dev/sdx
function clone_HD {
    local _SOURCE="$1"
    local _TARGET="$2"
    local _ORIGIN_TARGET=${_TARGET}

    # Load partition scheme if partition.yml exists in source
    load_partition_scheme "$_SOURCE" || return 1

    local _PARTITIONS=$(echo "$_JSON_PARTITIONS"|jq -r '.[] | "\(.number);\(.name);\(.size);"' 2>/dev/null)
    mcs_log "  [DEBUG] Total partitions in scheme: $(echo "$_JSON_PARTITIONS" | jq '. | length')"
    mcs_log "  [DEBUG] Partitions to process: $(echo "$_PARTITIONS" | grep -c ";" || echo 0)"

    local _NUMBER
    local _NAME

    make_HD "$_TARGET" ""

    echo "  [DEBUG] Argument 1 (Image Path): $1" >&2
    echo "  [DEBUG] Argument 2 (Target Disk): $2" >&2

    _SOURCE=$(connect_HD "$1")
    if [ -z "$_SOURCE" ]; then
        echo "  [ERROR] Failed to connect source: $1" >&2
        return 1
    fi
    _TARGET=$(connect_HD "$2")
    if [ -z "$_TARGET" ]; then
        echo "  [ERROR] Failed to connect target: $2" >&2
        disconnect_HD "$_SOURCE"
        return 1
    fi
    
    echo "  [DEBUG] Connected Source: $_SOURCE" >&2
    echo "  [DEBUG] Connected Target: $_TARGET" >&2

    IFS=$'\n'
    for _PARTITION in $_PARTITIONS
    do
        _NUMBER=$(echo "$_PARTITION" | awk -F ";" '{print $1}')
        _NAME=$(echo "$_PARTITION" | awk -F ";" '{print $2}')
        _SIZE=$(echo "$_PARTITION" | awk -F ";" '{print $3}')
        
        mcs_log "  [DEBUG] Checking partition $_NUMBER: $_NAME"
        
        case "$_NAME" in
            "HOME"|"SYSTEM" )
                if [ $_NAME = "HOME" ]
                then
                    _SIZE=$(max_home_size $_TARGET)
                fi
                mcs_log " "
                mcs_log "Clonando: $_NAME"
                mcs_log "================"

                if [[ "$_SOURCE" == http* ]]; then
                    _DEV_PART_TARGET=$(part_by_label_on_device "$_TARGET" "$_NAME")
                    if [ -z "$_DEV_PART_TARGET" ]; then
                        _DEV_PART_TARGET=$(part_by_id "$_TARGET" "$_NUMBER")
                    fi
                    echo "  [DEBUG] Target device: $_DEV_PART_TARGET" | tee -a /tmp/mcs-clone.log

                    # Use partition name directly. Fallback to DATA.raw only if name is HOME and .raw is missing
                    # TODO: Move this logic to project metadata in partition.yml to avoid hardcoded fallbacks
                    local _REMOTE_URL="${_SOURCE}${_NAME}.raw"
                    if [ "$_NAME" = "HOME" ]; then
                        # Only use DATA.raw if we are sure it's the right fallback, but for now 
                        # let's just use the name from partition.yml which is more predictable.
                        _REMOTE_URL="${_SOURCE}${_NAME}.raw"
                    fi
                    mcs_log "  [+] Copying partition $_NAME via wget from ${_REMOTE_URL}..."
                    wget -O - "$_REMOTE_URL" | dd of="${_DEV_PART_TARGET}" bs=1M status=progress 2>&1 | tee -a /tmp/mcs-clone.log
                    sync
                    verify_partition_checksum "$_DEV_PART_TARGET" "$_NAME" || mcs_log "  [WARNING] Integrity check failed for $_NAME"
                elif [ -d "$_SOURCE" ]; then
                    _DEV_PART_TARGET=$(part_by_label_on_device "$_TARGET" "$_NAME")
                    if [ -z "$_DEV_PART_TARGET" ]; then
                        _DEV_PART_TARGET=$(part_by_id "$_TARGET" "$_NUMBER")
                    fi
                    echo "  [DEBUG] Target device: $_DEV_PART_TARGET" | tee -a /tmp/mcs-clone.log

                    local _RAW_FILE="${_SOURCE}/${_NAME}.raw"
                    if [ "$_NAME" = "HOME" ] && [ ! -f "$_RAW_FILE" ]; then
                        _RAW_FILE="${_SOURCE}/DATA.raw"
                    fi

                    if [ -f "$_RAW_FILE" ]; then
                        mcs_log "  [+] Copying partition $_NAME from ${_RAW_FILE}..."
                        dd if="$_RAW_FILE" of="${_DEV_PART_TARGET}" bs=1M status=progress 2>&1 | tee -a /tmp/mcs-clone.log
                        sync
                        verify_partition_checksum "$_DEV_PART_TARGET" "$_NAME" || mcs_log "  [WARNING] Integrity check failed for $_NAME"
                    else
                        _DEV_PART_SOURCE=$(part_by_label_on_device "$_SOURCE" "$_NAME")
                        if [ -z "$_DEV_PART_SOURCE" ]; then
                            _DEV_PART_SOURCE=$(part_by_id "$_SOURCE" "$_NUMBER")
                        fi
                        echo "  [DEBUG] Source device: $_DEV_PART_SOURCE" | tee -a /tmp/mcs-clone.log

                        echo "  [WARNING] Raw image not found: $_RAW_FILE, falling back to rsync..." | tee -a /tmp/mcs-clone.log
                        if [ -n "$_DEV_PART_SOURCE" ]; then
                            mkdir -p /mnt/source
                            _FSTYPE=$(blkid -o value -s TYPE "${_DEV_PART_SOURCE}")
                            if [ -n "$_FSTYPE" ]; then
                                mount -o ro -t "$_FSTYPE" "${_DEV_PART_SOURCE}" /mnt/source 2>&1 | tee -a /tmp/mcs-clone.log
                            else
                                mount -o ro "${_DEV_PART_SOURCE}" /mnt/source 2>&1 | tee -a /tmp/mcs-clone.log
                            fi

                            echo "  [+] Copying files for $_NAME (rsync)..." | tee -a /tmp/mcs-clone.log
                            mkdir -p /mnt/target
                            mount -o rw,noatime,nodiratime,nodiscard -t auto "${_DEV_PART_TARGET}" /mnt/target 2>&1 | tee -a /tmp/mcs-clone.log
                            rsync -aHAXx --info=progress2 --numeric-ids --ignore-errors --timeout=120 --delete /mnt/source/ /mnt/target/ 2>&1 | tee -a /tmp/mcs-clone.log
                            sync
                            verify_partition_checksum "$_DEV_PART_TARGET" "$_NAME" || mcs_log "  [WARNING] Integrity check failed for $_NAME"

                            umount /mnt/source 2>/dev/null
                            rmdir /mnt/source
                            umount /mnt/target 2>/dev/null
                            rmdir /mnt/target
                        fi
                    fi
                else
                    echo "  [ERROR] Unknown source type for $_NAME cloning." | tee -a /tmp/mcs-clone.log
                fi

                ;;
            *)
                ;;
        esac
    done
    IFS=''
    disconnect_HD $_TARGET
    disconnect_HD $_SOURCE

    rescue $_ORIGIN_TARGET

}



# set_hostname /dev/sdc PCXXXXX
function set_hostname {
    local _DEVICE="$1"
    local _PC="$2"
    local _MOUNT="/mnt/rescue"

    _DEVICE=$(connect_HD ${_DEVICE})
    mkdir -p ${_MOUNT}
    mount -t auto $(part_by_name "${_DEVICE}" "SYSTEM" ) ${_MOUNT}

    # modificación del /etc/hosts
    echo "$_PC" > ${_MOUNT}/etc/hostname
    _FILE=${_MOUNT}/etc/azl-lan/hosts.d/10_localhost
    /bin/sed -i.bak -e "/^127\.0\.1\.1.*$/d" $_FILE && rm -f ${_FILE}.bak
    echo "127.0.1.1     ${_PC}.red.zaragoza.es  ${_PC}" >> $_FILE

    umount ${_MOUNT} 2>/dev/null
    rmdir ${_MOUNT}
    disconnect_HD $_DEVICE
}


function rescue {
    local _DEVICE="$1"
    local _MOUNT="/mnt/rescue"

    echo
    echo "Configuring Bootloader (Rescue)"
    echo "=============================="

    _DEVICE=$(connect_HD "${_DEVICE}")
    local _DEV_SYSTEM=$(part_by_name "$_DEVICE" SYSTEM)
    local _DEV_EFI=$(part_by_name "$_DEVICE" EFI)

    mkdir -p "${_MOUNT}"
    mount -t auto "${_DEV_SYSTEM}" "${_MOUNT}"

    # Mount EFI if exists
    if [ -n "$_DEV_EFI" ]; then
        mkdir -p "${_MOUNT}/boot/efi"
        mount -t auto "${_DEV_EFI}" "${_MOUNT}/boot/efi"
    fi

    # Mount API filesystems
    for dir in dev proc sys run; do
        mount --bind "/$dir" "${_MOUNT}/$dir"
    done

    # FSTAB
    echo "Updating /etc/fstab..."
    make_fstab "$_DEVICE" > "${_MOUNT}/etc/fstab"

    # Install GRUB (BIOS)
    mcs_log "Installing GRUB (BIOS)..."
    # Create a device map for GRUB to be sure it points to the right NBD device
    echo "(hd0) ${_DEVICE}" > "${_MOUNT}/boot/grub/device.map"
    
    # Try installing from inside chroot first, but with more modules
    if chroot "${_MOUNT}" which grub-install >/dev/null 2>&1; then
        chroot "${_MOUNT}" grub-install --target=i386-pc --force --modules="part_gpt biosdisk" "${_DEVICE}" 2>&1 | tee -a /tmp/mcs-clone.log
    else
        mcs_log "  [WARNING] grub-install not found inside target, trying from host..."
        grub-install --target=i386-pc --boot-directory="${_MOUNT}/boot" --force "${_DEVICE}" 2>&1 | tee -a /tmp/mcs-clone.log
    fi
    
    # Install GRUB (UEFI) if EFI partition exists
    if [ -n "$_DEV_EFI" ]; then
        mcs_log "Installing GRUB (UEFI)..."
        if chroot "${_MOUNT}" which grub-install >/dev/null 2>&1; then
            chroot "${_MOUNT}" grub-install --target=x86_64-efi --efi-directory=/boot/efi --bootloader-id=grub --force 2>&1 | tee -a /tmp/mcs-clone.log
        else
            mcs_log "  [WARNING] grub-install (UEFI) not found inside target, skipping chroot install..."
        fi
        # Fallback for some BIOS
        mkdir -p "${_MOUNT}/boot/efi/EFI/BOOT"
        cp "${_MOUNT}/boot/efi/EFI/grub/grubx64.efi" "${_MOUNT}/boot/efi/EFI/BOOT/BOOTX64.EFI" 2>/dev/null
    fi

    # Update GRUB config (Alpine style)
    mcs_log "Updating GRUB configuration..."
    if chroot "${_MOUNT}" which grub-mkconfig >/dev/null 2>&1; then
        chroot "${_MOUNT}" grub-mkconfig -o /boot/grub/grub.cfg 2>&1 | tee -a /tmp/mcs-clone.log
    else
        mcs_log "  [WARNING] grub-mkconfig not found inside target, skipping configuration update..."
    fi

    # Fix root= references: replace /dev/sdXN with PARTUUID=xxx
    # grub-mkconfig hardcodes the device path seen during chroot (e.g. /dev/sdb4)
    # but when the disk boots as the primary drive it becomes /dev/sda4
    local _PARTUUID_SYSTEM=$(blkid -o value -s PARTUUID "${_DEV_SYSTEM}")
    if [ -n "$_PARTUUID_SYSTEM" ]; then
        echo "Fixing root= in grub.cfg: ${_DEV_SYSTEM} -> PARTUUID=${_PARTUUID_SYSTEM}" | tee -a /tmp/mcs-clone.log
        sed -i.bak "s|root=${_DEV_SYSTEM}|root=PARTUUID=${_PARTUUID_SYSTEM}|g" "${_MOUNT}/boot/grub/grub.cfg" && rm -f "${_MOUNT}/boot/grub/grub.cfg.bak"
        sed -i.bak "s|root=UUID=[^ ]*|root=PARTUUID=${_PARTUUID_SYSTEM}|g" "${_MOUNT}/boot/grub/grub.cfg" && rm -f "${_MOUNT}/boot/grub/grub.cfg.bak"
    fi

    echo "Syncing and unmounting..."
    sync
    
    # Clean up mounts
    for dir in dev proc sys run; do
        umount -l "${_MOUNT}/$dir" 2>/dev/null
    done
    umount "${_MOUNT}/boot/efi" 2>/dev/null
    umount "${_MOUNT}" 2>/dev/null
    rmdir "${_MOUNT}"

    disconnect_HD "${_DEVICE}"
}


function clone_iso {
    local _FILE_ISO="$1"
    local _DEVICE="$2"

    echo
    echo "Clone ${_FILE_ISO} -> ${_DEVICE}"
    _DEVICE=$(connect_HD ${_DEVICE})
    #wipefs --all --force ${_DEVICE}
    dd if=${_FILE_ISO} of=${_DEVICE} bs=4M status=progress
    #rsyncrsync --info=stats2 -aHAXx /mnt/source/ /mnt/target
    sync
    partprobe
    disconnect_HD ${_DEVICE}

}


function resize_MCS_DATA() {
    local LABEL="MCS_DATA"
    local PART=$(part_by_label "$LABEL")
    local DISK=$(disk_by_label "$LABEL")

    umount $PART
    parted --script --fix  $DISK resizepart 4 100%
    partprobe $DISK
    sleep 2
    e2fsck -f -p $PART
    resize2fs $PART
    mount $PART /mcsdata
}

